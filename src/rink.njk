    ctx.save(); ctx.beginPath(); ctx.arc(g.cx, by, br, 0, 7); ctx.clip();
    ctx.strokeStyle = 'rgba(20,10,50,0.5)'; ctx.lineWidth = 1;
    for (let i = -3; i <= 3; i++) { ctx.beginPath(); ctx.moveTo(g.cx - br, by + i * br * 0.3); ctx.lineTo(g.cx + br, by + i * br * 0.3); ctx.stroke(); }
    const shift = (now / 90) % (br * 0.4);
    for (let i = -4; i <= 4; i++) { const x = g.cx + i * br * 0.4 + shift; ctx.beginPath(); ctx.moveTo(x, by - br); ctx.lineTo(x, by + br); ctx.stroke(); }
    ctx.restore();
  }

  function frame(now) {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    run(dt, now);
    draw(now);
    requestAnimationFrame(frame);
  }

  function place() {
    you.x = g.cx; you.y = g.cy + (g.vert ? g.a + g.R * 0.45 : g.R * 0.6);
    const b = benchPos(); quiet.x = b[0]; quiet.y = b[1];
    // a pass so nobody starts at the origin
    for (const c of crowd) { const pos = trackPos(c.s, g.R * c.lane); c.x = pos[0]; c.y = pos[1]; }
  }

  addEventListener('resize', () => {
    measure(); signSpots();
    const b = bone(you.x, you.y); if (b.d > g.R) place();
  });

  people();
  measure();
  signSpots();
  place();
  $('laps').textContent = mem.laps + (mem.laps === 1 ? ' lap' : ' laps');

  // measuring clears the canvas, and with reduced motion no frame is coming to repaint it
  if (document.fonts) document.fonts.ready.then(() => { measure(); signSpots(); if (still) draw(performance.now()); });

  if (still) {
    // your computer asked for nothing to move. nothing moves. the song's still here if you want it
    changeProgram(program(Date.now()));
    run(0, performance.now());
    draw(performance.now());
    speak('your computer asked me not to move, so the floor\'s standing still for you. the rooms are on the walls 🪩💖✨🌟', 1e9);
    addEventListener('resize', () => { draw(performance.now()); });
    return;
  }
  sayUntil = performance.now() + 9000;
  requestAnimationFrame((t) => { last = t; frame(t); });
})();
</script>
</body>
</html>
