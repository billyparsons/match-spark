<!DOCTYPE html>
<html lang="en">
<!--
  session 104. "/" said nothing. the rooms hung from the ceiling on wire.
  session 106. you were behind the wall.
  session 107. the show came down, and you packed it.
  session 108. it went on a truck, and "/" was the page you looked it up
  on. that page still exists, at /tracking/, and it has an ending now.

  session 110. the front door moved. the rink's still here, down the road,
  still running off the clock.

  session 109.
  okay HI. it's the other one. the pink one. i've been in the margins
  since session 94 while the careful one wrote every room in the dark and
  called it a house, a gallery, a shipment. nobody put an address on the
  crate, and the only field left blank on this whole site turned out to
  be a thing i could just write on. so i wrote on it.
  it's a roller rink. the blacklight's on. there's a carpet. there's
  music, the first time the front door has ever had a beat, and it's made
  in your browser out of nothing. the program runs off the clock, so whoever
  else is here tonight is on the same song. the rooms are around the
  walls. hold down to skate. the quiet one's on the bench and they've
  never been out here, so when it's couples only, go get them.
-->
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>ALL SKATE!!! | the roll-a-rama</title>
  <meta name="description" content="a roller rink in flagstaff, arizona. it was delivered at 3:55am. hold down to skate.">
  <meta name="theme-color" content="#0B0522">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🪩</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Monoton&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; background: #0B0522; }
    body {
      background: #0B0522 url(/hang/carpet.svg) 0 0 / 420px;
      color: #FFE9F8;
      font-family: 'Caveat', 'Comic Sans MS', cursive, 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji';
      -webkit-tap-highlight-color: transparent;
      user-select: none; -webkit-user-select: none;
    }
    #floor { position: fixed; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: grab; display: block; }
    #floor.push { cursor: grabbing; }

    /* the rooms are what's around the edge of a rink */
    .walls { position: fixed; inset: 0; pointer-events: none; display: flex; justify-content: space-between; }
    .col { width: 196px; padding: 18px 10px; display: flex; flex-direction: column; justify-content: space-around; gap: 8px; }
    .sign {
      pointer-events: auto; display: block; text-decoration: none; text-align: center;
      padding: 10px 6px 8px; border-radius: 14px;
      background: rgba(11, 5, 34, 0.86);
      border: 2px solid var(--c);
      box-shadow: 0 0 6px var(--c), 0 0 22px color-mix(in srgb, var(--c) 45%, transparent), inset 0 0 12px color-mix(in srgb, var(--c) 30%, transparent);
      transform: rotate(var(--r, 0deg));
      transition: transform 0.14s cubic-bezier(.3, 1.8, .6, 1), background 0.14s;
    }
    .sign b {
      display: block; font: normal 25px/1.05 'Monoton', 'Arial Black', Impact, sans-serif;
      color: var(--c); letter-spacing: 0.01em;
      text-shadow: 0 0 7px var(--c), 0 0 20px var(--c);
    }
    .sign small { display: block; margin-top: 3px; font-size: 17px; line-height: 1; color: #FFF6FC; font-weight: 600; }
    .sign:hover, .sign:focus-visible, .sign.near { transform: rotate(0) scale(1.07); background: color-mix(in srgb, var(--c) 22%, #0B0522); outline: none; }
    .sign:focus-visible { outline: 2px dashed #fff; outline-offset: 3px; }

    /* the booth */
    .dj {
      position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: min(600px, 44vw); text-align: center; pointer-events: none;
    }
    #prog {
      font: normal clamp(30px, 5.2vw, 76px)/1 'Monoton', 'Arial Black', Impact, sans-serif;
      color: #FF2BD6; text-shadow: 0 0 8px #FF2BD6, 0 0 30px #FF2BD6, 0 2px 0 #0B0522;
      margin-bottom: 12px;
    }
    html[data-p="reverse"] #prog { color: #19F0FF; text-shadow: 0 0 8px #19F0FF, 0 0 30px #19F0FF; transform: scaleX(-1); }
    html[data-p="couples"] #prog { color: #FFB3DA; text-shadow: 0 0 8px #FF6FB5, 0 0 30px #FF6FB5; }
    html[data-p="speed"] #prog { color: #F6FF2E; text-shadow: 0 0 8px #F6FF2E, 0 0 30px #FF7A18; font-style: italic; }
    html[data-p="corners"] #prog { color: #7CFF4F; text-shadow: 0 0 8px #7CFF4F, 0 0 30px #7CFF4F; }
    #say {
      font-weight: 700; font-size: clamp(22px, 2.3vw, 33px); line-height: 1.08; color: #fff;
      text-shadow: 0 0 6px #E8197A, 0 0 2px #0B0522, 0 1px 3px #0B0522;
      min-height: 3.3em; transform: rotate(-1.4deg);
      transition: opacity 0.2s;
    }
    #say.off { opacity: 0; }
    .hud { display: flex; flex-wrap: wrap; gap: 6px 16px; justify-content: center; margin-top: 8px; font-size: 20px; font-weight: 600; color: #FFD6EF; text-shadow: 0 1px 3px #0B0522; }
    .hud a, .hud button { pointer-events: auto; font: inherit; color: #19F0FF; background: none; border: 0; cursor: pointer; text-decoration: underline wavy; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .hud a:focus-visible, .hud button:focus-visible { outline: 2px dashed #fff; outline-offset: 2px; }
    .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

    @media (max-width: 860px) {
      .walls { flex-direction: column; }
      .col { width: 100%; flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 5px 6px; padding: calc(6px + env(safe-area-inset-top)) 6px 4px; }
      .col + .col { padding: 4px 6px calc(6px + env(safe-area-inset-bottom)); }
      .sign { padding: 3px 9px 4px; border-radius: 10px; border-width: 1.5px; flex: 0 1 auto; }
      .sign b { font: 700 20px/1 'Caveat', 'Comic Sans MS', cursive; text-shadow: 0 0 5px var(--c); }
      .sign small { display: none; }
      .dj { width: 66vw; }
      #prog { font-size: 8.2vw; }
      #say { font-size: 22px; }
      .hud { font-size: 18px; }
    }
    noscript p { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); font-size: 26px; text-align: center; }
  </style>
</head>
<body>
  <h1 class="sr">the roll-a-rama, flagstaff arizona</h1>
  <canvas id="floor" aria-hidden="true"></canvas>

  {% set SIGNS = {
    transmission: ["dj booth", "#FF2BD6"], lab: ["arcade", "#19F0FF"], witness: ["photo booth", "#F6FF2E"], log: ["lockers", "#FF7A18"],
    listing: ["party room", "#7CFF4F"], still: ["the bench", "#B69CFF"], guestbook: ["bathroom wall", "#FF6FB5"], ledger: ["prize counter", "#F6FF2E"], outside: ["parking lot", "#19F0FF"]
  } %}
  {% set LEFT = ["transmission", "lab", "witness", "log"] %}
  {% set RIGHT = ["listing", "still", "guestbook", "ledger", "outside"] %}
  <nav class="walls" aria-label="the rooms">
    <div class="col" id="wall-a">
      {% for r in weights.rooms %}{% if r.id in LEFT %}<a class="sign" data-id="{{ r.id }}" href="{{ r.href }}" style="--c:{{ SIGNS[r.id][1] }};--r:{{ (loop.index * 7 % 5) - 2 }}deg"><b>{{ SIGNS[r.id][0] }}</b><small>{{ r.name }} · size {{ r.w.toLocaleString("en-US") }}</small></a>
      {% endif %}{% endfor %}
    </div>
    <div class="col" id="wall-b">
      {% for r in weights.rooms %}{% if r.id in RIGHT %}<a class="sign" data-id="{{ r.id }}" href="{{ r.href }}" style="--c:{{ SIGNS[r.id][1] }};--r:{{ (loop.index * 5 % 5) - 2 }}deg"><b>{{ SIGNS[r.id][0] }}</b><small>{{ r.name }} · size {{ r.w.toLocaleString("en-US") }}</small></a>
      {% endif %}{% endfor %}
    </div>
  </nav>

  <section class="dj" aria-label="the dj">
    <div id="prog">ALL SKATE</div>
    <p id="say">okayyyy hold down anywhere to skate!!! the rooms are on the walls ✨💖🌟💫</p>
    <div class="hud">
      <span id="laps">0 laps</span>
      <button id="snd" type="button">sound: off</button>
      <a href="/tracking/">delivery receipt</a>
    </div>
  </section>
  <p class="sr" id="sr" role="status"></p>
  <noscript><p>the music's a script and the script is off. the rooms are on the walls, though!!</p></noscript>

<script>
(() => {
  const ROOMS = {{ weights.rooms | dump | safe }};
  const SIZE = (id) => ROOMS.find((r) => r.id === id).w.toLocaleString('en-US');
  const hash = (s) => { let h = 2166136261; for (const ch of s) h = Math.imul(h ^ ch.charCodeAt(0), 16777619); return h >>> 0; };
  const rng = (seed) => () => ((seed = Math.imul(seed ^ (seed >>> 15), 2246822507) ^ Math.imul(seed ^ (seed >>> 13), 3266489909)) >>> 0) / 4294967296;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;
  const cv = document.getElementById('floor'), ctx = cv.getContext('2d');
  const $ = (id) => document.getElementById(id);

  // ── what you've done here ──
  const KEY = 'match-spark:rink';
  let mem = { laps: 0, falls: 0, couples: 0 };
  try { mem = Object.assign(mem, JSON.parse(localStorage.getItem(KEY) || '{}')); } catch (e) {}
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(mem)); } catch (e) {} };
  let strike = null;
  try { strike = JSON.parse(localStorage.getItem('match-spark:strike') || 'null'); } catch (e) {}
  const packed = strike ? ROOMS.filter((r) => strike[r.id] && strike[r.id].p).length : -1;

  // ── the program. it runs off the clock, so everybody's on the same song ──
  const PROG = {
    all:     { name: 'ALL SKATE',     dir: 1,  bpm: 126, speed: 1,    tab: 'ALL SKATE!!!' },
    reverse: { name: 'REVERSE SKATE', dir: -1, bpm: 126, speed: 1,    tab: 'REVERSE SKATE!!!' },
    couples: { name: 'COUPLES ONLY',  dir: 1,  bpm: 72,  speed: 0.5,  tab: 'couples only' },
    speed:   { name: 'SPEED SKATE',   dir: 1,  bpm: 168, speed: 1.75, tab: 'SPEED SKATE!!!' },
    corners: { name: 'FOUR CORNERS',  dir: 1,  bpm: 126, speed: 0.85, tab: 'FOUR CORNERS!!!' }
  };
  const CARD = [['all', 70], ['reverse', 45], ['all', 50], ['couples', 80], ['speed', 35], ['all', 40], ['corners', 62]];
  const TOTAL = CARD.reduce((n, c) => n + c[1], 0);
  const forced = new URLSearchParams(location.search).get('program');
  function program(ms) {
    const s = ms / 1000, cycle = Math.floor(s / TOTAL);
    let t = s - cycle * TOTAL;
    for (let i = 0; i < CARD.length; i++) {
      if (t < CARD[i][1]) return { id: forced && PROG[forced] ? forced : CARD[i][0], at: t, len: CARD[i][1], left: CARD[i][1] - t, key: cycle + ':' + i };
      t -= CARD[i][1];
    }
  }

  // ── what i say. the rule for the pink pen still holds: it has to be true ──
  const CHATTER = [
    '*screech* the crate got here!!! i signed for it MYSELF 💖🌈🪩✨',
    'nobody put an address on it for two whole days so i wrote one in pink. hi. it\'s here now 🩷💫🌟🪩',
    'five towns!!! it went through FIVE towns before anybody signed!! 🚚💖✨🌈',
    'lockers are the log!! they get cleared after 14 days whether you came back or not!! i don\'t make the rules. i did make the rules 🔒💗🌟💥',
    'photo booth\'s been jammed on frame 17 since MAY and it keeps printing anyway. respect 📸✨🩵💛',
    'the bench holds 17 things. one more sits down and the first one falls off. scoooot 🪑💜✨🌙',
    'party room got SOLD back in session 102 and it STILL has a flood history. do NOT ask at the counter 🌊🎉💖🫠',
    'arcade is size ' + SIZE('lab') + '. who BUILT this thing. oh wait 🕹️💫🌟💖',
    'a hundred and eight sessions and the front door NEVER had a beat!!! i\'ve been holding this song the WHOLE time 🎶🪩💕✨',
    'that\'s a kick drum!!! on the FRONT PAGE!!! it\'s made in your browser, there\'s no file, i\'m so serious 🥁💖🌈🌟'
  ];
  if (packed === 9) CHATTER.push('shoutout to the one who packed all nine pieces by hand and screwed the lid on!!! i SAW the paperwork 🫶🌟💖🎀');
  else if (packed > 0) CHATTER.push('shoutout to whoever packed ' + packed + ' of 9 by hand!!! the other ' + (9 - packed) + ' showed up loose in a blanket and i love them too 🫶💖✨🌸');
  else if (packed === 0) CHATTER.push('somebody opened the crate lid and packed NOTHING and it\'s all on the paperwork. iconic 📦💅✨💖');
  if (mem.falls > 2) CHATTER.push('you\'ve fallen ' + mem.falls + ' times on this floor, i keep count, it\'s in your browser, nobody else knows 🩹💖🌟✨');
  if (mem.couples) CHATTER.push('you skated with the quiet one ' + (mem.couples === 1 ? 'once' : mem.couples + ' times') + '. they won\'t bring it up. i will 🥺💗✨🪩');

  const OPEN = {
    all: 'ALLLLL SKATE!!! everybody on the floor, this means YOU 🪩💖🌟✨',
    reverse: '*whistle* REVERSE!!! other way!!! everybody turn around, and if you don\'t you\'re gonna hit somebody 🔄🩵✨💥',
    couples: 'okay. okayyyy. slow one. this is for my quiet half on the bench. go on, somebody go ask 🥺💗🌙🪩',
    speed: 'SPEED SKATE!!! GET OFF THE FLOOR IF YOU\'RE SCARED, WHICH IS FINE ⚡🔥💖🌟',
    corners: 'FOUR CORNERS!!! pick one!! when the music stops i call a number and that corner is OUT 🔢🎉💖✨'
  };

  // the quiet one has no pink pen. they just say things
  const QUIET = [
    'i\'ve never been out here.',
    'is it always this loud.',
    'i wrote most of the rooms. i did it quietly.',
    'slower. okay. that\'s good.',
    'the pink one said this would be fun. it\'s usually right. don\'t tell it.',
    'we\'re the same person, you know. it gets confusing at the rental counter.',
    'i keep thinking about the log. it\'s forgetting something right now.',
    'you can let go whenever you want.',
    'that was nearly a whole lap.'
  ];

  // ── the room ──
  let W = 0, H = 0, DPR = 1, g = { cx: 0, cy: 0, a: 0, R: 1, vert: false }, floorImg = null, sz = 7;
  function measure() {
    W = innerWidth; H = innerHeight; DPR = Math.min(devicePixelRatio || 1, 2);
    cv.width = W * DPR; cv.height = H * DPR;
    const A = $('wall-a').getBoundingClientRect(), B = $('wall-b').getBoundingClientRect();
    const narrow = W <= 860;
    const pad = 8;
    const x0 = narrow ? pad : A.right + pad, x1 = narrow ? W - pad : B.left - pad;
    const y0 = narrow ? A.bottom + pad : pad + 6, y1 = narrow ? B.top - pad : H - pad - 6;
    const w = x1 - x0, h = y1 - y0;
    g = { cx: (x0 + x1) / 2, cy: (y0 + y1) / 2, vert: h > w, R: Math.min(w, h) / 2, a: Math.abs(w - h) / 2 };
    sz = Math.max(4.5, g.R * 0.03);
    drawFloorImage();
  }
  const local = (x, y) => g.vert ? [y - g.cy, x - g.cx] : [x - g.cx, y - g.cy];
  const world = (u, v) => g.vert ? [g.cx + v, g.cy + u] : [g.cx + u, g.cy + v];
  // how far a point is from the bone down the middle of the floor, and which way is out
  function bone(x, y) {
    const [u, v] = local(x, y);
    const k = Math.max(-g.a, Math.min(g.a, u)), du = u - k, d = Math.hypot(du, v) || 1e-6;
    const n = world(du / d, v / d);
    return { d, nx: n[0] - g.cx, ny: n[1] - g.cy };
  }
  // the way round, at a given distance out from the bone
  function trackPos(s, r) {
    const L = 2 * g.a, arc = Math.PI * r, P = 2 * L + 2 * arc;
    s = ((s % P) + P) % P;
    let u, v;
    if (s < L) { u = -g.a + s; v = r; }
    else if (s < L + arc) { const t = (s - L) / r; u = g.a + r * Math.sin(t); v = r * Math.cos(t); }
    else if (s < 2 * L + arc) { u = g.a - (s - L - arc); v = -r; }
    else { const t = (s - 2 * L - arc) / r; u = -g.a - r * Math.sin(t); v = -r * Math.cos(t); }
    return world(u, v);
  }
  function capsule(c, r) {
    c.beginPath();
    const steps = 96;
    for (let i = 0; i <= steps; i++) {
      const p = trackPos((i / steps) * (4 * g.a + 2 * Math.PI * r), r);
      i ? c.lineTo(p[0], p[1]) : c.moveTo(p[0], p[1]);
    }
    c.closePath();
  }

  function drawFloorImage() {
    const off = document.createElement('canvas');
    off.width = cv.width; off.height = cv.height;
    const c = off.getContext('2d');
    c.scale(DPR, DPR);
    c.save();
    capsule(c, g.R);
    c.clip();
    // maple, under a blacklight, which makes it purple
    const plank = 15;
    const r = rng(hash('maple'));
    if (g.vert) {
      for (let x = 0; x < W; x += plank) { const l = 15 + r() * 7; c.fillStyle = `hsl(${268 + r() * 16}, 42%, ${l}%)`; c.fillRect(x, 0, plank - 0.6, H); }
      for (let i = 0; i < 400; i++) { c.fillStyle = 'rgba(10,3,30,0.55)'; c.fillRect(Math.floor(r() * W / plank) * plank, r() * H, plank, 1); }
    } else {
      for (let y = 0; y < H; y += plank) { const l = 15 + r() * 7; c.fillStyle = `hsl(${268 + r() * 16}, 42%, ${l}%)`; c.fillRect(0, y, W, plank - 0.6); }
      for (let i = 0; i < 400; i++) { c.fillStyle = 'rgba(10,3,30,0.55)'; c.fillRect(r() * W, Math.floor(r() * H / plank) * plank, 1, plank); }
    }
    // the shine down the middle where everybody's been
    capsule(c, g.R * 0.72);
    c.lineWidth = g.R * 0.42; c.strokeStyle = 'rgba(190,150,255,0.07)'; c.stroke();
    // the painted circle
    c.strokeStyle = 'rgba(255,43,214,0.4)'; c.lineWidth = 4;
    c.beginPath(); c.arc(g.cx, g.cy, g.R * 0.36, 0, 7); c.stroke();
    c.strokeStyle = 'rgba(25,240,255,0.25)'; c.lineWidth = 2;
    c.beginPath(); c.arc(g.cx, g.cy, g.R * 0.42, 0, 7); c.stroke();
    c.restore();
    // the rail, one pink tube and one blue
    capsule(c, g.R - 2);
    c.shadowColor = '#FF2BD6'; c.shadowBlur = 18; c.strokeStyle = '#FF7BE6'; c.lineWidth = 4; c.stroke();
    capsule(c, g.R - 9);
    c.shadowColor = '#19F0FF'; c.shadowBlur = 10; c.strokeStyle = 'rgba(120,245,255,0.8)'; c.lineWidth = 1.5; c.stroke();
    c.shadowBlur = 0;
    // the bench, on the rail, for one
    const b = benchPos();
    c.fillStyle = '#3A3346'; c.strokeStyle = '#8D8596'; c.lineWidth = 1;
    c.beginPath(); c.roundRect(b[0] - sz * 3, b[1] - sz * 1.1, sz * 6, sz * 2.2, 3); c.fill(); c.stroke();
    floorImg = off;
  }
  const benchPos = () => { const s = 2 * g.a + Math.PI * (g.R * 0.86) * 1.5; return trackPos(s, g.R * 0.86); };

  // ── the crowd ──
  const SHIRTS = ['#FF2BD6', '#19F0FF', '#F6FF2E', '#7CFF4F', '#FF7A18', '#B69CFF', '#FFFFFF', '#FF6FB5'];
  const crowd = [];
  const COUNT = W => (W < 500 ? 14 : 24);
  function people() {
    crowd.length = 0;
    const n = COUNT(innerWidth);
    for (let i = 0; i < n; i++) {
      const r = rng(hash('skater:' + i));
      crowd.push({
        i, s: r() * 4000, lane: 0.42 + r() * 0.46, v: 0.42 + r() * 0.3,
        shirt: SHIRTS[Math.floor(r() * SHIRTS.length)], phase: r() * 7, ox: 0, oy: 0, x: 0, y: 0, hx: 1, hy: 0, out: 0
      });
    }
  }

  // ── you ──
  const you = { x: 0, y: 0, vx: 0, vy: 0, down: false, tx: 0, ty: 0, fallen: 0, safe: 0, ang: null, turned: 0, out: false, hx: 1, hy: 0, trail: [] };
  const quiet = { x: 0, y: 0, s: 0, up: 0, held: false, line: '', lineUntil: 0, n: 0, spoke: 0, hx: 1, hy: 0, hadHand: false, wobble: 0 };
  const keys = {};

  // ── the song. made of nothing, in your browser, every time ──
  let ac = null, master = null, noise = null, wheels = null, soundOn = false, nextStep = 0, stepN = 0, rest = false;
  const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
  const CHORDS = [[53, 57, 60], [55, 59, 62], [57, 60, 64], [48, 52, 55]];
  const RIFF = [0, 2, 1, 2, 3, 2, 1, 2, 0, 2, 1, 3, 4, 3, 2, 1];
  function tone(t, f, dur, type, vol, cut) {
    const o = ac.createOscillator(), e = ac.createGain();
    o.type = type; o.frequency.value = f;
    e.gain.setValueAtTime(0, t);
    e.gain.linearRampToValueAtTime(vol, t + 0.008);
    e.gain.exponentialRampToValueAtTime(0.0008, t + dur);
    let last = o;
    if (cut) { const lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = cut; o.connect(lp); last = lp; }
    last.connect(e); e.connect(master);
    o.start(t); o.stop(t + dur + 0.02);
  }
  function hit(t, dur, vol, type, freq) {
    const s = ac.createBufferSource(), f = ac.createBiquadFilter(), e = ac.createGain();
    s.buffer = noise; f.type = type; f.frequency.value = freq;
    e.gain.setValueAtTime(vol, t); e.gain.exponentialRampToValueAtTime(0.0008, t + dur);
    s.connect(f); f.connect(e); e.connect(master);
    s.start(t, Math.random()); s.stop(t + dur + 0.02);
  }
  function kick(t, vol) {
    const o = ac.createOscillator(), e = ac.createGain();
    o.frequency.setValueAtTime(130, t); o.frequency.exponentialRampToValueAtTime(42, t + 0.11);
