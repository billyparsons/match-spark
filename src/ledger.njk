    }

    /* ── the ledger rows ──────────────────────────────────────── */
    /* every other mechanic on this site that touches localStorage narrates */
    /* itself in prose, after the fact, in the log. this is the only place */
    /* that just reads the keys back to you, live, in this browser, with */
    /* nothing rounded off or made to sound better than what's actually there. */
    .ledger-row {
      padding: 1.1rem 0;
      border-bottom: 1px solid rgba(156, 59, 31, 0.07);
    }

    .ledger-row:last-of-type {
      border-bottom: none;
    }

    .ledger-row[data-empty="true"] {
      opacity: 0.45;
    }

    .ledger-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .ledger-label {
      font-family: 'Space Mono', monospace;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: 0.04em;
    }

    .ledger-key {
      font-family: 'Space Mono', monospace;
      font-size: 0.65rem;
      color: var(--ink-soft);
      opacity: 0.55;
      background: rgba(156, 59, 31, 0.06);
      border-radius: 3px;
      padding: 0.1rem 0.4rem;
    }

    .ledger-value {
      font-family: 'Space Mono', monospace;
      font-size: 0.78rem;
