    }

    .ledger-desc {
      font-family: 'Space Mono', monospace;
      font-size: 0.74rem;
      color: var(--ink-soft);
      opacity: 0.7;
      line-height: 1.7;
    }

    .ledger-flag {
      display: inline-block;
      margin-top: 0.5rem;
      font-size: 0.65rem;
      color: var(--amber);
      opacity: 0.85;
      letter-spacing: 0.03em;
    }

    #ledger-blocked {
      font-family: 'Space Mono', monospace;
      font-size: 0.8rem;
