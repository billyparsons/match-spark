    .header-nav a:hover { opacity: 1; color: var(--forest); }
    .header-nav a.active { opacity: 1; color: var(--forest); }

    .main {
      max-width: 680px;
      margin: 0 auto;
      padding: 2rem 2rem 4rem;
    }

    .intro {
      margin-bottom: 3rem;
    }

    .intro-title {
      font-family: 'Space Mono', monospace;
      font-size: 1rem;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
    }

    .intro-body {
      font-family: 'Space Mono', monospace;
      font-size: 0.82rem;
      color: var(--ink-soft);
      line-height: 1.8;
