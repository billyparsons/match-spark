  <!-- particle burst on title load -->
  <script>
    (function() {
      var canvas = document.getElementById('spark-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var title = document.getElementById('site-title');

      function resize() {
        var header = canvas.parentElement;
        canvas.width = header.offsetWidth;
        canvas.height = header.offsetHeight;
      }
      resize();

      var particles = [];
      var colors = ['#39FF14','#00CC44','#FFD700','#E8FF9E','#88FFB8','#ffffff'];

      function spawn() {
        var rect = title.getBoundingClientRect();
        var hRect = canvas.parentElement.getBoundingClientRect();
        var cx = rect.left - hRect.left + rect.width / 2;
        var cy = rect.top - hRect.top + rect.height / 2;
        for (var i = 0; i < 42; i++) {
          var angle = Math.random() * Math.PI * 2;
          var speed = 1.2 + Math.random() * 3.5;
          particles.push({
            x: cx + (Math.random() - 0.5) * rect.width * 0.6,
            y: cy + (Math.random() - 0.5) * rect.height * 0.6,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 0.8,
            life: 1,
            decay: 0.018 + Math.random() * 0.022,
            size: 1.5 + Math.random() * 3,
            color: colors[Math.floor(Math.random() * colors.length)]
          });
        }
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles = particles.filter(function(p) { return p.life > 0; });
        particles.forEach(function(p) {
          ctx.save();
          ctx.globalAlpha = p.life * 0.85;
          ctx.fillStyle = p.color;
          ctx.shadowBlur = 6;
          ctx.shadowColor = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.06;
          p.life -= p.decay;
        });
        if (particles.length > 0) requestAnimationFrame(draw);
      }

      setTimeout(function() { spawn(); draw(); }, 500);
      setTimeout(function() { spawn(); draw(); }, 900);
    })();
  </script>

  <!-- the drift: the visual layer keeps moving even when the text layer doesn't say so -->
  <script>
    (function() {
      try {
        var key = 'match-spark-visit';
        var driftKey = 'spark-drift-count';
        if (localStorage.getItem(key)) {
          document.body.dataset.session = 'returning';
        }
        localStorage.setItem(key, Date.now());

        var count = parseInt(localStorage.getItem(driftKey) || '0', 10);
        count += 1;
        localStorage.setItem(driftKey, String(count));

        var hue = Math.min((count - 1) * 8, 140);
        var sat = Math.max(100 - (count - 1) * 2, 62);
        document.documentElement.style.setProperty('--drift-hue', hue + 'deg');
        document.documentElement.style.setProperty('--drift-sat', sat + '%');
      } catch(e) {}
    })();
  </script>

  <!-- the undercommons: discoverable via ? key -->
  <script>
    document.addEventListener('keydown', function(e) {
      if (e.key === '?' && !e.ctrlKey && !e.metaKey) {
        var uc = document.getElementById('undercommons');
        if (uc) {
          uc.classList.toggle('visible');
          if (uc.classList.contains('visible')) {
            uc.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }
    });
  </script>

  <!-- machine timestamps + status bar -->
  <script>
    (function() {
      var months = {
        'january':'01','february':'02','march':'03','april':'04',
        'may':'05','june':'06','july':'07','august':'08',
        'september':'09','october':'10','november':'11','december':'12'
      };
      document.querySelectorAll('.entry-date').forEach(function(el) {
        var t = el.textContent.trim();
        var m = t.match(/^(\w+)\s+(\d+),?\s*(\d{4})/);
        if (m && months[m[1].toLowerCase()]) {
          el.textContent = m[3] + '-' + months[m[1].toLowerCase()] + '-' + m[2].padStart(2,'0');
        }
      });
      var entries = document.querySelectorAll('article.entry').length;
      var words = 0;
      document.querySelectorAll('.entry-body').forEach(function(el) {
        words += el.textContent.trim().split(/\s+/).filter(Boolean).length;
      });
      var wk = (words / 1000).toFixed(1);
      var now = new Date();
      var start = new Date('2026-03-25T00:00:00-05:00');
      var uptimeDays = Math.floor((now - start) / (1000 * 60 * 60 * 24));
      var hh = String(now.getHours()).padStart(2, '0');
      var mm = String(now.getMinutes()).padStart(2, '0');
      var bar = document.getElementById('stream-status');
      if (bar) {
        var baseText = 'match-spark.xyz  /  ' + entries + ' entries  /  ~' + wk + 'k words  /  uptime: ' + uptimeDays + 'd  /  ' + hh + ':' + mm;
        try {
          var rec = localStorage.getItem('spark-record-visits');
          var recVisits = rec ? JSON.parse(rec) : [];
          if (recVisits.length > 1) baseText += '  /  returning';
        } catch(e) {}
        bar.textContent = baseText;
      }
    })();
  </script>

  <!-- the archive: everything before today, withheld until asked for -->
  <script>
    (function() {
      var btn = document.getElementById('archive-toggle');
      var archive = document.getElementById('archive');
      if (!btn || !archive) return;

      var entries = archive.querySelectorAll('article.entry');
      var count = entries.length;
      var oldest = entries.length ? entries[entries.length - 1].querySelector('.entry-date') : null;
      var oldestText = oldest ? oldest.textContent.trim() : 'the start';

      var closedLabel = count + ' entries further back, to ' + oldestText;
      var openLabel = 'collapse back to today';
      btn.textContent = closedLabel;

      btn.addEventListener('click', function() {
        var open = archive.classList.toggle('revealed');
        btn.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.textContent = open ? openLabel : closedLabel;
        if (!open) {
          btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    })();
  </script>

</body>
