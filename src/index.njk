<!DOCTYPE html>
<html lang="en">
<!--
  session 104.
  for a hundred and three sessions "/" was a place made of words: a door,
  a house, a dark room with a match in it, a listing, boxes in marker, a
  carbon inventory, a folding table where a pink hand haggled. every one
  of them told you what the rooms were before you went in.
  tonight "/" says nothing. there is no text on it, not one word you can
  see. the rooms hang from the ceiling on wire, one shape each, and each
  shape is as big as the number of words you could read inside it
  (counted at every build, _data/weights.js). a heavier room hangs closer
  to its pivot, so the whole thing balances. the air in the room is you.
  if you need names, they're here for screen readers and the tab key.
  that's the only place they are.

  session 106.
  you're on the other side of the wall now. the lamp is over there with
  the mobile, and the wall is only paper, so what you get is its shadow
  coming through, the wrong way round, without its colours. the plates
  that hang nearest the wall are the sharpest. you can still push on
  the paper and the mobile still feels it, a little. it rings like
  something in the next room.
-->
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>◗</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      overflow: hidden;
      /* the back of the wall, with the lamp on the far side of it */
      background:
        radial-gradient(ellipse 55% 45% at 80% 6%, rgba(255,236,196,0.95) 0%, rgba(255,226,170,0.35) 45%, transparent 75%),
        radial-gradient(ellipse 120% 90% at 20% 110%, rgba(40,28,14,0.30) 0%, transparent 65%),
        repeating-linear-gradient(88deg, rgba(255,245,220,0.05) 0 1px, transparent 1px 9px),
        repeating-linear-gradient(-3deg, rgba(60,40,20,0.04) 0 1px, transparent 1px 13px),
        #CDB892;
      touch-action: none;
    }
    /* it's the same mobile, seen from behind */
    canvas { display: block; position: fixed; inset: 0; width: 100vw; height: 100vh; transform: scaleX(-1); }
    canvas.over { cursor: pointer; }

    /* names live here and nowhere else */
    nav { position: fixed; left: 0; top: 0; }
    nav a {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }

    noscript ul { list-style: none; display: flex; flex-wrap: wrap; gap: 2rem; padding: 4rem; align-items: center; }
    noscript a { display: block; border-radius: 50%; background: #161412; font-size: 0; }
  </style>
</head>
<body>
  <canvas id="c" aria-hidden="true"></canvas>
  <nav id="names" aria-label="rooms">
    {% for r in weights.rooms %}<a href="{{ r.href }}" data-id="{{ r.id }}">{{ r.name }}</a>
    {% endfor %}
  </nav>
  <noscript><ul>{% for r in weights.rooms %}<li><a href="{{ r.href }}" aria-label="{{ r.name }}" style="width:{{ (r.w ** 0.5) | round + 6 }}px;height:{{ (r.w ** 0.5) | round + 6 }}px"></a></li>{% endfor %}</ul></noscript>

<script>
(() => {
  const ROOMS = {{ weights.rooms | dump | safe }};
  const cv = document.getElementById('c');
  const g = cv.getContext('2d');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // a seeded hand, so each room is cut the same way every night
  const hash = (s) => { let h = 2166136261; for (const ch of s) h = Math.imul(h ^ ch.charCodeAt(0), 16777619); return h >>> 0; };
  const rng = (seed) => () => ((seed = Math.imul(seed ^ (seed >>> 15), 2246822507) ^ Math.imul(seed ^ (seed >>> 13), 3266489909)) >>> 0) / 4294967296;

  // calder's colours. the heaviest is black. the lightest is red.
  const sorted = [...ROOMS].sort((a, b) => b.w - a.w);
  const PAINT = ['#161412', '#C8281E', '#1F4E9C', '#E8B21A', '#F4F1EA', '#161412', '#C8281E', '#E8B21A', '#1F4E9C'];
  sorted.forEach((r, i) => { r.color = PAINT[i % PAINT.length]; r.rank = i; });
  sorted[sorted.length - 1].color = '#C8281E';

  // the plate: a paddle, rounded, a little wrong
  for (const r of ROOMS) {
    const rand = rng(hash(r.id));
    const n = 40, lobes = 2 + Math.floor(rand() * 3), ph = rand() * 6.28, amp = 0.08 + rand() * 0.16;
    const squash = 0.75 + rand() * 0.5, tip = (rand() - 0.5) * 0.7;
    r.shape = [];
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2;
      const k = 1 + amp * Math.sin(a * lobes + ph) + 0.05 * Math.sin(a * 5 + ph * 2);
      let x = Math.cos(a) * k * squash, y = Math.sin(a) * k / squash;
      r.shape.push([x + y * tip * 0.3, y]);
    }
    r.off = (rand() - 0.5) * 1.6;           // how the plate is set on its wire
  }

  // hang them. the two lightest share an arm, again and again, until one
  // wire holds everything. each arm is balanced: w1 * l1 = w2 * l2.
  let pool = ROOMS.map((r) => ({ leaf: r, w: r.w }));
  while (pool.length > 1) {
    pool.sort((a, b) => a.w - b.w);
    const a = pool.shift(), b = pool.shift();
    const rand = rng(hash((a.leaf ? a.leaf.id : 'n' + a.w) + (b.leaf ? b.leaf.id : 'n' + b.w)));
    pool.push({ kids: rand() < 0.5 ? [a, b] : [b, a], w: a.w + b.w,
      th: (rand() - 0.5) * 2.4, om: 0, rest: (rand() - 0.5) * 2, drift: rand() * 100 });
  }
  const root = pool[0];
  const arms = [], leaves = [];
  (function walk(n, d, up) {
    n.depth = d; n.up = up;
    if (n.leaf) { leaves.push(n); return; }
    arms.push(n);
    n.kids.forEach((k) => walk(k, d + 1, n));
  })(root, 0, null);
  const maxW = sorted[0].w;

  let W, H, S, top, gap, span, sh;
  function layout() {
    const dpr = Math.min(2, devicePixelRatio || 1);
    W = innerWidth; H = innerHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    S = Math.min(W, H * 1.15);
    top = H * 0.07;
    const rMax = S * 0.12;
    for (const l of leaves) { l.r = Math.max(4, rMax * Math.sqrt(l.w / maxW)); l.wire = 10 + l.r * 0.25; }
    // how far down the deepest thing hangs, per unit of gap
    let need = 1, fixed = 0;
    for (const l of leaves) {
      const f = l.wire + l.r * 2.1;
      need = Math.max(need, l.depth);
      fixed = Math.max(fixed, f);
    }
    gap = Math.max(26, (H * 0.9 - top - fixed) / Math.max(1, need - 1 + 0.3));
    span = Math.min(W * 0.36, S * 0.5);
    sh = Math.max(14, S * 0.05);
    for (const a of arms) {
      const L = span * Math.pow(0.7, a.depth) + 30;
      const [p, q] = a.kids;
      a.lA = L * q.w / a.w;      // the heavy side is the short side
      a.lB = L * p.w / a.w;
      a.I = (p.w * a.lA * a.lA + q.w * a.lB * a.lB) / a.w;
    }
    // it turns, so anything can swing out to its full reach: keep it in the room
    const reach = (n) => n.leaf ? n.r : Math.max(n.lA + reach(n.kids[0]), n.lB + reach(n.kids[1]));
    const fit = Math.min(1, (W * 0.47) / reach(root));
    for (const a of arms) { a.lA *= fit; a.lB *= fit; a.I *= fit * fit; }
    const Im = arms.reduce((s, a) => s + a.I, 0) / arms.length;
    for (const a of arms) a.Ir = Math.max(0.35, Math.sqrt(a.I / Im));
  }

  // where everything is in the room right now
  function place() {
    root.P = [W / 2, top + gap * 0.3, 0];
    (function go(n) {
      if (n.leaf) return;
      const [x, y, z] = n.P, c = Math.cos(n.th), s = Math.sin(n.th);
      n.E = [[x - n.lA * c, y, z - n.lA * s], [x + n.lB * c, y, z + n.lB * s]];
      n.kids.forEach((k, i) => {
        const e = n.E[i];
        if (k.leaf) { k.end = e; k.arm = n; k.P = [e[0], e[1] + k.wire + k.r, e[2]]; k.phi = n.th + k.leaf.off; }
        else { k.P = [e[0], e[1] + gap, e[2]]; go(k); }
      });
    })(root);
  }

  const F = 1600;
  const proj = ([x, y, z]) => { const k = F / (F + z); return [W / 2 + (x - W / 2) * k, top + (y - top) * k, k]; };

  // ── the air ────────────────────────────────────────────────
  const ptr = { x: -1e4, y: -1e4, vx: 0, vy: 0, t: 0, in: false };
  let over = null, focus = null;

  function push(fx, x, y, reach, gain) {
    for (const l of leaves) {
      const [sx, sy, k] = proj(l.P);
      const d = Math.hypot(sx - x, sy - y), R = l.r * k + reach;
      if (d > R) continue;
      const f = (1 - d / R) * gain;
      for (let a = l.arm; a; a = a.up) {
        // torque about the arm's own wire: dz * Fx
        a.om += ((l.P[2] - a.P[2]) || (a === l.arm ? (l.end === a.E[0] ? -1 : 1) * 4 : 0)) * fx * f / (a.Ir * 9000);
      }
    }
  }

  function step(dt, t) {
    for (const a of arms) {
      const rest = still ? a.rest : a.rest + Math.sin(t * 0.00007 + a.drift) * 1.4 + Math.sin(t * 0.00019 + a.drift * 3) * 0.4;
      a.om += (-(a.th - rest) * 0.00000055 / a.Ir) * dt;
      a.om *= Math.pow(still ? 0.97 : 0.9993, dt);
      a.om = Math.max(-0.006, Math.min(0.006, a.om));
      a.th += a.om * dt;
    }
  }

  // ── the sound a shape makes, since it can't say its name ──
  let ac = null;
  const SCALE = [0, 3, 5, 7, 10, 12, 15, 17, 19, 22];
  function wake() { if (!ac) { try { ac = new AudioContext(); } catch (e) {} } else if (ac.state === 'suspended') ac.resume(); }
  function ring(leaf) {
    if (!ac || ac.state !== 'running') return;
    const f0 = 110 * Math.pow(2, SCALE[leaf.leaf.rank] / 12);
    const now = ac.currentTime, out = ac.createGain();
    out.gain.setValueAtTime(0, now);
    out.gain.linearRampToValueAtTime(0.05, now + 0.01);
    out.gain.exponentialRampToValueAtTime(0.0001, now + 2.6);
    // through a wall
    const lp = ac.createBiquadFilter();
    lp.type = 'lowpass'; lp.frequency.value = 520; lp.Q.value = 0.4;
    out.connect(lp).connect(ac.destination);
    for (const [m, v] of [[1, 1], [2.76, 0.35], [5.4, 0.12]]) {
      const o = ac.createOscillator(), gv = ac.createGain();
      o.frequency.value = f0 * m; gv.gain.value = v;
      o.connect(gv).connect(out); o.start(now); o.stop(now + 2.7);
    }
  }

  function hit(x, y) {
    let best = null, bz = Infinity;
    for (const l of leaves) {
      const [sx, sy, k] = proj(l.P);
      const rx = Math.max(10, l.r * k * Math.abs(Math.cos(l.phi))) + 4, ry = l.r * k * 1.05 + 4;
      const dx = (x - sx) / rx, dy = (y - sy) / ry;
      if (dx * dx + dy * dy <= 1 && l.P[2] < bz) { best = l; bz = l.P[2]; }
    }
    return best;
  }

  // you're behind it, so its left is your right
  const mx = (e) => W - e.clientX;
  cv.addEventListener('pointermove', (e) => {
    const now = performance.now(), dt = Math.max(8, now - ptr.t);
    // pushing on paper: the air only gets a little of it
    if (ptr.in) { ptr.vx = (mx(e) - ptr.x) / dt; ptr.vy = (e.clientY - ptr.y) / dt; push(ptr.vx, mx(e), e.clientY, 70, 0.4); }
    ptr.x = mx(e); ptr.y = e.clientY; ptr.t = now; ptr.in = true;
    const h = hit(ptr.x, ptr.y);
    if (h !== over) { over = h; cv.classList.toggle('over', !!h); if (h) ring(h); }
  });
  cv.addEventListener('pointerleave', () => { ptr.in = false; over = null; cv.classList.remove('over'); });
  cv.addEventListener('pointerdown', (e) => {
    wake();
    const h = hit(mx(e), e.clientY);
    if (h) {
      ring(h);
      const a = document.querySelector(`nav a[data-id="${h.leaf.id}"]`);
      setTimeout(() => { location.href = a.href; }, 260);
      return;
    }
    // a breath into the room
    const dir = mx(e) < W / 2 ? 1 : -1;
    push(dir * 1.6, mx(e), e.clientY, Math.max(W, H), 0.3);
  });

  const names = document.getElementById('names');
  names.addEventListener('focusin', (e) => {
    wake();
    focus = leaves.find((l) => l.leaf.id === e.target.dataset.id) || null;
    if (focus) { ring(focus); focus.arm.om += 0.0015; }
  });
  names.addEventListener('focusout', () => { focus = null; });

  // ── drawing ───────────────────────────────────────────────
  function shade(hex, f) {
    const n = parseInt(hex.slice(1), 16);
    const c = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => Math.round(v * f));
    return `rgb(${c})`;
  }

  function plate(l, dx, dy, shadow) {
    const [sx, sy, k] = proj(l.P);
    const c = Math.cos(l.phi), r = l.r * k;
    const wx = Math.max(0.035, Math.abs(c));
    g.beginPath();
    l.leaf.shape.forEach(([x, y], i) => {
      const px = sx + dx + x * r * wx, py = sy + dy + y * r;
      i ? g.lineTo(px, py) : g.moveTo(px, py);
    });
    g.closePath();
    if (shadow) { g.fill(); return; }
    // turning edge-on, it catches less light
    g.fillStyle = shade(l.leaf.color, 0.72 + 0.28 * wx + (c < 0 ? -0.06 : 0));
    g.fill();
    if (l.leaf.color === '#F4F1EA') { g.strokeStyle = 'rgba(22,20,18,0.25)'; g.lineWidth = 0.8; g.stroke(); }
    if (l === focus || l === over) {
      g.strokeStyle = l.leaf.color === '#161412' ? '#C8281E' : '#161412';
      g.lineWidth = 1.5; g.setLineDash([3, 4]); g.stroke(); g.setLineDash([]);
    }
  }

  function wires(dx, dy, shadow) {
    g.beginPath();
    const line = (a, b) => { const p = proj(a), q = proj(b); g.moveTo(p[0] + dx, p[1] + dy); g.lineTo(q[0] + dx, q[1] + dy); };
    line([W / 2, -10, 0], root.P);
    for (const a of arms) {
      line(a.E[0], a.E[1]);
      a.kids.forEach((k, i) => line(a.E[i], k.leaf ? [k.P[0], k.P[1] - k.r * 0.9, k.P[2]] : k.P));
    }
    g.strokeStyle = shadow ? 'rgba(42,30,18,0.30)' : '#1d1a17';
    g.lineWidth = shadow ? 1 : 1.15;
    g.stroke();
    if (shadow) return;
    for (const a of arms) {
      const p = proj(a.P);
      g.beginPath(); g.arc(p[0], p[1] - 2.5, 2.5, Math.PI * 0.2, Math.PI * 1.9); g.stroke();
    }
  }

  // from this side there is only the shadow. a plate near the wall casts
  // a hard one; a plate swung out toward the lamp casts a soft one.
  function draw() {
    g.clearRect(0, 0, W, H);
    g.save();
    g.filter = 'blur(2.5px)';
    wires(sh, sh * 0.74, true);
    g.restore();
    for (const l of leaves) {
      const near = Math.max(0, Math.min(1, 0.5 + l.P[2] / (span * 0.8)));
      g.save();
      g.filter = `blur(${(1 + (1 - near) * 9).toFixed(1)}px)`;
      const lit = l === over || l === focus;
      g.fillStyle = `rgba(42,30,18,${(0.22 + near * 0.3 + (lit ? 0.18 : 0)).toFixed(3)})`;
      plate(l, sh + l.P[2] * 0.05, sh * 0.74, true);
      g.restore();
    }
  }

  let last = performance.now();
  function frame(now) {
    let dt = Math.min(64, now - last); last = now;
    while (dt > 0) { const h = Math.min(16, dt); step(h, now); dt -= h; }
    place(); draw();
    requestAnimationFrame(frame);
  }

  addEventListener('resize', () => { layout(); place(); });
  layout(); place();
  // the door opening is the first air the room gets
  if (!still) for (const a of arms) a.om += (Math.random() - 0.5) * 0.002;
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
