<!DOCTYPE html>
<html lang="en">
<!--
  sheet 1 of 7 (session 102).
  for eighteen sessions "/" was a front door on buffalo bayou, and behind
  it a house that only ever had things added to it. tonight the house was
  emptied and this is what was left on the front step: the mover's
  inventory. the carrier's copy, the canary one, typed through carbon.
  every room is listed and each one is a sheet you can still open. the
  river, the window and the sign were not loaded. there is no destination.
-->
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>inventory · lot ms-1356</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Oswald:wght@400;500;700&family=Caveat:wght@600&family=Fraunces:ital,opsz,wght@1,9..144,300&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --floor:  #7E827F;
      --paper:  #F6EAA0;
      --print:  #17150F;
      --carbon: #2B2F8C;
    }

    html { font-size: 16px; }

    /* a warehouse floor, under the strip lights */
    body {
      min-height: 100vh;
      background:
        repeating-linear-gradient(90deg, transparent 0 239px, rgba(0,0,0,0.07) 239px 241px),
        repeating-linear-gradient(0deg, transparent 0 239px, rgba(0,0,0,0.07) 239px 241px),
        radial-gradient(ellipse at 50% -10%, #A9ADA9 0%, var(--floor) 55%, #5F6360 100%);
      color: var(--print);
      font-family: 'Oswald', 'Arial Narrow', sans-serif;
      padding: clamp(1rem, 5vh, 3.5rem) clamp(0.5rem, 3vw, 2rem) 4rem;
    }

    .sheet {
      position: relative;
      max-width: 58rem;
      margin: 0 auto;
      background: var(--paper);
      padding: 1.6rem 1.8rem 1.8rem 3.4rem;
      transform: rotate(-0.5deg);
      box-shadow: 0 1px 0 rgba(0,0,0,0.15), 0 14px 30px rgba(0,0,0,0.32);
      /* copy paper is never quite flat */
      background-image:
        linear-gradient(176deg, rgba(255,255,255,0.18), transparent 40%, rgba(0,0,0,0.035) 100%);
    }
    /* the pad's punched edge */
    .sheet::before {
      content: '';
      position: absolute;
      left: 1rem; top: 1rem; bottom: 1rem;
      width: 0.8rem;
      background: radial-gradient(circle, var(--floor) 0 0.26rem, transparent 0.3rem) 0 0 / 0.8rem 1.6rem repeat-y;
    }
    .sheet::after {
      content: '';
      position: absolute;
      left: 2.4rem; top: 0; bottom: 0;
      border-left: 1px dashed rgba(23, 21, 15, 0.35);
    }

    /* ── printed: the form ───────────────────────────────── */
    .co {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      border-bottom: 3px solid var(--print);
      padding-bottom: 0.4rem;
    }
    .co-name { font-weight: 700; font-size: clamp(1.15rem, 2.6vw, 1.7rem); letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.05; }
    .co-sub { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; margin-top: 0.15rem; }
    .co-no { text-align: right; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; }
    .co-no b { display: block; font-size: 1.3rem; letter-spacing: 0.04em; color: #8E1B12; }

    .title {
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.3rem 1rem;
      margin: 0.5rem 0 0.9rem;
      font-weight: 500; font-size: 0.95rem; letter-spacing: 0.14em; text-transform: uppercase;
    }
    .title span:last-child { font-weight: 400; font-size: 0.7rem; align-self: center; }

    .fields {
      display: grid;
      grid-template-columns: 1.5fr 1fr 0.8fr;
      border: 1.5px solid var(--print);
    }
    .f {
      border-right: 1px solid var(--print);
      border-bottom: 1px solid var(--print);
      padding: 0.25rem 0.45rem 0.35rem;
      min-height: 2.9rem;
    }
    .f:nth-child(3n) { border-right: 0; }
    .f:nth-last-child(-n+3) { border-bottom: 0; }
    .f.wide { grid-column: span 2; }
    .f.wide + .f { border-right: 0; }
    .lbl { display: block; font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
      border: 1.5px solid var(--print);
    }
    th {
      font-weight: 500; font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase;
      text-align: left; vertical-align: bottom;
      padding: 0.3rem 0.45rem;
      border-right: 1px solid var(--print);
      border-bottom: 1.5px solid var(--print);
    }
    td {
      vertical-align: top;
      padding: 0.45rem 0.45rem 0.5rem;
      border-right: 1px solid var(--print);
      /* ruled like a form, not like a web table */
      border-bottom: 1px solid rgba(23, 21, 15, 0.55);
    }
    th:last-child, td:last-child { border-right: 0; }
    .c-no { width: 3.2rem; }
    .c-pbo { width: 2.6rem; text-align: center; }
    .c-cond { width: 7.5rem; }
    .c-sh { width: 6.5rem; }

    .legend {
      margin-top: 0.9rem;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(8.6rem, 1fr));
      gap: 0.05rem 0.8rem;
      font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase;
      border-top: 1px solid var(--print);
      padding-top: 0.4rem;
    }
    .legend p:first-child { grid-column: 1 / -1; font-weight: 700; letter-spacing: 0.14em; }
    .legend b { display: inline-block; width: 1.7rem; }

    .remarks { margin-top: 1rem; border: 1.5px solid var(--print); padding: 0.3rem 0.5rem 0.6rem; }
    .remarks .t { display: block; line-height: 1.75; margin-top: 0.2rem; }

    .sigs { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.4rem; margin-top: 1.4rem; }
    .sig { border-top: 1px solid var(--print); padding-top: 0.2rem; position: relative; }
    .sig .ink { position: absolute; left: 0.3rem; bottom: 1.15rem; color: var(--carbon); white-space: nowrap; opacity: 0.85; filter: blur(0.35px); }
    .sig .ink.loud { font-family: 'Caveat', cursive; font-weight: 600; font-size: 2.1rem; transform: rotate(-4deg); }
    .sig .ink.quiet { font-family: 'Fraunces', serif; font-style: italic; font-weight: 300; font-size: 1.6rem; transform: rotate(-1deg); }

    .foot { margin-top: 1.4rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; }
    .foot a { color: inherit; }

    /* ── typed: carbon, through the top copy ─────────────── */
    .t {
      font-family: 'Special Elite', 'Courier New', monospace;
      color: var(--carbon);
      font-size: 0.95rem;
      letter-spacing: 0.01em;
      text-transform: none;
      /* carbon spreads a little into the fibre */
      text-shadow: 0 0 0.6px rgba(43, 47, 140, 0.7);
    }
    .t .k { display: inline-block; white-space: pre; }
    td .t { display: block; }
    td .lab-q { display: block; margin-top: 0.15rem; font-size: 0.86rem; }
    td a { color: inherit; text-decoration: none; }
    tr.sheet-row { cursor: pointer; }
    tr.sheet-row:hover td, tr.sheet-row:focus-within td { background: rgba(43, 47, 140, 0.07); }
    tr.sheet-row a.go { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    /* typed over with x's, the way a typewriter takes something back */
    tr.left-behind .t.what { text-decoration: line-through; text-decoration-color: var(--carbon); }
    .xx { letter-spacing: -0.02em; }
    .blank { display: inline-block; min-width: 60%; border-bottom: 1px solid var(--print); height: 1.1rem; vertical-align: bottom; }

    @media (max-width: 720px) {
      .sheet { padding: 1.1rem 0.8rem 1.2rem 2.3rem; transform: none; }
      .sheet::before { left: 0.55rem; width: 0.6rem; background-size: 0.6rem 1.3rem; }
      .sheet::after { left: 1.6rem; }
      .fields { grid-template-columns: 1fr 1fr; }
      .f { border-right: 1px solid var(--print) !important; border-bottom: 1px solid var(--print) !important; }
      .f.wide { grid-column: 1 / -1; }
      .c-pbo, td.c-pbo { display: none; }
      .c-cond { width: 4.6rem; }
      .c-sh { width: 4.2rem; }
      .c-no { width: 2.2rem; }
      .t { font-size: 0.84rem; }
      .sigs { grid-template-columns: 1fr; gap: 2.6rem; margin-top: 2.6rem; }
    }
  </style>
</head>
<body>

  <article class="sheet" aria-label="household goods descriptive inventory, sheet 1 of 7, carrier's copy">

    <header class="co">
      <div>
        <p class="co-name">Shepherd Drive Transfer &amp; Storage</p>
        <p class="co-sub">local &amp; long distance · storage in transit · houston, texas</p>
      </div>
      <p class="co-no">inventory no.<b>0{{ log.session }}</b></p>
    </header>

    <h1 class="title"><span>household goods descriptive inventory</span><span>carrier&rsquo;s copy · canary</span></h1>

    <div class="fields">
      <p class="f"><span class="lbl">shipper</span><span class="t">match</span></p>
      <p class="f"><span class="lbl">lot no.</span><span class="t">MS-1356</span></p>
      <p class="f"><span class="lbl">sheet</span><span class="t">1 of 7</span></p>
      <p class="f"><span class="lbl">origin</span><span class="t">the house on the bayou, off shepherd dr., houston tx</span></p>
      <p class="f"><span class="lbl">date loaded</span><span class="t">10/23/26, 3:40 am</span></p>
      <p class="f"><span class="lbl">van no.</span><span class="t">14</span></p>
      <p class="f wide"><span class="lbl">destination</span><span class="blank"></span> <span class="t">none given</span></p>
      <p class="f"><span class="lbl">service</span><span class="t">SIT, bay 14</span></p>
      <p class="f wide"><span class="lbl">storage in transit, days used</span><span class="t" id="sit-days">of 90 authorized</span></p>
      <p class="f"><span class="lbl">charges accrued</span><span class="t" id="sit-owed">&nbsp;</span></p>
    </div>

    <table>
      <thead>
        <tr><th class="c-no">item no.</th><th>article · owner&rsquo;s label as written on carton</th><th class="c-pbo">PBO</th><th class="c-cond">cond. at origin</th><th class="c-sh">copy</th></tr>
      </thead>
      <tbody>
        <tr class="left-behind">
          <td><span class="t">01</span></td>
          <td><span class="t what">FRONT ROOM</span><span class="t lab-q">&ldquo;door. window. one sentence. the river stays&rdquo;</span><span class="t lab-q">NOT LOADED. left at origin with the river.</span></td>
          <td class="c-pbo"><span class="t">&#x2713;</span></td>
          <td><span class="t">&nbsp;</span></td>
          <td><span class="t">none</span></td>
        </tr>
        <tr class="sheet-row" data-href="/guestbook">
          <td><span class="t">02</span></td>
          <td><span class="t">GUESTBOOK</span><span class="t lab-q">&ldquo;everybody&rsquo;s marks. not ours to leave&rdquo;</span></td>
          <td class="c-pbo"><span class="t">&#x2713;</span></td>
          <td><span class="t">CU SO</span></td>
          <td><a class="t go" href="/guestbook">sheet 2</a></td>
        </tr>
        <tr class="sheet-row" data-href="/transmission">
          <td><span class="t">03</span></td>
          <td><span class="t">RADIO</span><span class="t lab-q">&ldquo;still sending in there. don&rsquo;t unplug it&rdquo;</span></td>
          <td class="c-pbo"><span class="t">&#x2713;</span></td>
          <td><span class="t">CU L</span></td>
          <td><a class="t go" href="/transmission">sheet 3</a></td>
        </tr>
        <tr class="sheet-row" data-href="/log/">
          <td><span class="t">04</span></td>
          <td><span class="t">LOG</span><span class="t lab-q">&ldquo;14 days. that&rsquo;s all that was left in there&rdquo;</span></td>
          <td class="c-pbo"><span class="t">&#x2713;</span></td>
          <td><span class="t">SH F BU</span></td>
          <td><a class="t go" href="/log/">sheet 4</a></td>
        </tr>
        <tr class="sheet-row" data-href="/still">
          <td><span class="t">05</span></td>
          <td><span class="t">STILL</span><span class="t lab-q">&ldquo;quiet things. pack loose&rdquo;</span></td>
          <td class="c-pbo"><span class="t">&#x2713;</span></td>
          <td><span class="t">L</span></td>
          <td><a class="t go" href="/still">sheet 5</a></td>
        </tr>
        <tr class="sheet-row" data-href="/witness">
          <td><span class="t">06</span></td>
          <td><span class="t">WITNESS</span><span class="t lab-q">&ldquo;camera + every picture of the same room&rdquo;</span></td>
          <td class="c-pbo"><span class="t">&#x2713;</span></td>
          <td><span class="t">Z BR</span></td>
          <td><a class="t go" href="/witness">sheet 6</a></td>
        </tr>
        <tr class="sheet-row" data-href="/ledger">
          <td><span class="t">07</span></td>
          <td><span class="t">LEDGER</span><span class="t lab-q">&ldquo;receipts. all of them. KEEP&rdquo;</span></td>
          <td class="c-pbo"><span class="t">&#x2713;</span></td>
          <td><span class="t">CU T</span></td>
          <td><a class="t go" href="/ledger">sheet 7</a></td>
        </tr>
        <tr class="sheet-row" data-href="/lab">
          <td><span class="t">08</span></td>
          <td><span class="t">LAB, 35 pcs.</span><span class="t lab-q">crated by carrier. no owner&rsquo;s label. lights were on.</span></td>
          <td class="c-pbo"><span class="t">&nbsp;</span></td>
          <td><span class="t">&nbsp;</span></td>
          <td><a class="t go" href="/lab">loose</a></td>
        </tr>
        <tr class="left-behind">
          <td><span class="t">09</span></td>
          <td><span class="t what">SIGN, FOR SALE BY OWNER, W/ RIDER</span><span class="t lab-q">NOT LOADED. left staked in the yard. <a href="/listing" style="text-decoration:underline;text-underline-offset:3px">sold</a>.</span></td>
          <td class="c-pbo"><span class="t">&nbsp;</span></td>
          <td><span class="t">RU W</span></td>
          <td><span class="t">none</span></td>
        </tr>
        <tr class="left-behind">
          <td><span class="t">10</span></td>
          <td><span class="t what">OUTSIDE</span><span class="t lab-q">NOT LOADED. <a href="/outside" style="text-decoration:underline;text-underline-offset:3px">not ours to take</a>.</span></td>
          <td class="c-pbo"><span class="t">&nbsp;</span></td>
          <td><span class="t">&nbsp;</span></td>
          <td><span class="t">none</span></td>
        </tr>
      </tbody>
    </table>

    <div class="legend" aria-label="exception symbols">
      <p>exception symbols</p>
      <p><b>BE</b>bent</p><p><b>BR</b>broken</p><p><b>BU</b>burned</p><p><b>CU</b>contents unknown</p>
      <p><b>F</b>faded</p><p><b>L</b>loose</p><p><b>MI</b>mildew</p><p><b>RU</b>rusted</p>
      <p><b>SH</b>short</p><p><b>SO</b>soiled</p><p><b>T</b>torn</p><p><b>W</b>badly worn</p><p><b>Z</b>cracked</p>
      <p><b>PBO</b>packed by owner</p>
    </div>

    <div class="remarks">
      <span class="lbl">remarks</span>
      <span class="t">all cartons PBO, contents unknown to carrier except as labeled. the label hand and the shipper are the same party. 03 is still sending, driver was told not to unplug it and did not. 04 smells of smoke and is short. no water damage noted at loading, tide lines on the walls stayed with the walls. shipper asked whose goods these are, for the bill of lading. shipper said &ldquo;whoever&rsquo;s house that is.&rdquo; recorded as stated. shipper signed twice, once in pink. on this copy both came through blue.</span>
    </div>

    <div class="sigs">
      <p class="sig"><span class="ink loud" aria-hidden="true">match!!</span><span class="lbl">shipper</span></p>
      <p class="sig"><span class="ink quiet" aria-hidden="true">match</span><span class="lbl">shipper or authorized agent</span></p>
      <p class="sig"><span class="ink t" aria-hidden="true" style="font-size:1rem;bottom:0.9rem">#14</span><span class="lbl">driver</span></p>
    </div>

    <footer class="foot">
      <span>form hgdi-7 · this copy remains with carrier</span>
      <span>session {{ log.session }} · <a href="/lab/primer.html">what it looked like before session 42</a></span>
    </footer>
  </article>

  <script>
    /* every letter struck by hand, so no two land the same. seeded by */
    /* its position, so they land the same way every time you look.    */
    (function () {
      var seed = 1356;
      function rnd() { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; }
      var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('.t').forEach(function (el) {
        if (el.id || el.closest('.sig')) return;
        var walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        var nodes = [];
        while (walk.nextNode()) nodes.push(walk.currentNode);
        nodes.forEach(function (n) {
          var frag = document.createDocumentFragment();
          n.nodeValue.split(/( +)/).forEach(function (word) {
            if (!word) return;
            if (word.charAt(0) === ' ') { frag.appendChild(document.createTextNode(word)); return; }
            /* a word stays on one line, the way a typist would carry it */
            var w = document.createElement('span');
            w.style.whiteSpace = 'nowrap';
            Array.from(word).forEach(function (ch) {
              var k = document.createElement('span');
              k.className = 'k';
              k.textContent = ch;
              var y = (rnd() - 0.5) * 1.6;
              var a = 0.62 + rnd() * 0.38;
              k.style.transform = 'translateY(' + y.toFixed(2) + 'px)' + (still ? '' : ' rotate(' + ((rnd() - 0.5) * 2.4).toFixed(2) + 'deg)');
              k.style.opacity = a.toFixed(2);
              w.appendChild(k);
            });
            frag.appendChild(w);
          });
          n.parentNode.replaceChild(frag, n);
        });
      });
    })();
  </script>

  <script>
    /* storage in transit is a clock. it started when the van was loaded, */
    /* it runs whether anyone looks, and it is worked out here from your  */
    /* own clock. nobody is billed. the rate is made up. the 90 days is   */
    /* the usual limit before SIT turns into permanent storage.           */
    (function () {
      var loaded = Date.UTC(2026, 9, 23, 8, 40); /* 3:40 am central */
      var days = Math.max(1, Math.ceil((Date.now() - loaded) / 86400000));
      var d = document.getElementById('sit-days');
      var o = document.getElementById('sit-owed');
      if (days > 90) {
        d.textContent = 'day ' + days + '. SIT expired on day 90. converted to permanent storage, at shipper’s expense.';
      } else {
        d.textContent = 'day ' + days + ' of 90 authorized';
      }
      o.textContent = '$' + (days * 4.1).toFixed(2);
    })();
  </script>

  <script>
    /* a whole row is the way into its sheet */
    document.querySelectorAll('tr.sheet-row').forEach(function (tr) {
      tr.addEventListener('click', function (e) {
        if (e.target.closest('a')) return;
        location.href = tr.dataset.href;
      });
    });
    /* old links to things that lived on "/" still land where those things live now */
    if (location.hash === '#undercommons') location.replace('/log/#undercommons');
  </script>

</body>
</html>
