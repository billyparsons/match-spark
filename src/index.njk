  <script src="/coat/coat.js"></script>
  <script>
    (() => {
      const $ = (id) => document.getElementById(id);
      const press = $('press'), what = $('what'), strip = $('strip'), big = $('n');
      const baked = document.documentElement.dataset.coat;
      let n = baked === '' ? null : Number(baked);
      let pressed = false, busy = false, gone = false;

      // every colour it's ever been comes out of the count. when there are
      // more than fit, the oldest run off the left edge
      function draw() {
        const w = strip.clientWidth, h = strip.clientHeight, dpr = devicePixelRatio || 1;
        strip.width = w * dpr; strip.height = h * dpr;
        const g = strip.getContext('2d');
        g.scale(dpr, dpr);
        const count = n || 0;
        const each = Math.max(4, count ? Math.min(w / count, 90) : 0);
        for (let i = 0; count - i >= 1 && w - i * each > -each; i++) {
          g.fillStyle = coat.colour(count - i);
          g.fillRect(w - (i + 1) * each, 0, each + 0.5, h);
        }
        g.fillStyle = coat.ink(coat.colour(count));
        g.fillRect(0, 0, w, 2);
      }

      function show() {
        const hex = coat.paint(n);
        $('chrome').content = hex;
        $('fav').href = "data:image/svg+xml," + encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'><rect width='1' height='1' fill='" + hex + "'/></svg>");
        document.title = String(n || 0);
        big.textContent = n || 0;
        $('which').textContent = n ? 'number ' + n + ', ' + coat.words(n) + '.' : "it's got no colour right now.";
        $('who').textContent =
          !n ? "the counter is gone, or it can't be reached. if it's gone, the first press starts it again at one."
          : n === 1 ? "nobody's touched it yet. number 1 was match, turning it on."
          : "match didn't pick it. whoever pressed last did, and nobody sighted was told what the button does. it's been pressed " + n + " times.";
        draw();
        if (typeof rub === 'function') rub(true);
        if (typeof scrawl === 'function') scrawl();
        sulk();
      }

      // the pen (session 118). the loud one only talks round the back
      function sulk() {
        const d = Math.floor((Date.now() - Date.parse('2026-11-02T03:00:00-06:00')) / 864e5);
        const t = taken;
        $('sulk').innerHTML = !n ? "the counter's GONE?? ...omg. ok. ok. somebody start it again 🫠💔🕯️🩷"
          : t >= TABS ? "every tab's GONE. " + t + " people took pickle home in their pocket 😭💗🐈‍⬛✨ " + (n === 1 ? "my button's still on <u>1</u>. that's correct actually. cats first" : "")
          : n === 1 && t > 0 ? "pickle's had " + t + " tab" + (t === 1 ? "" : "s") + " taken. i've been <u>1</u> for " + d + " days. ......it's FINE. it's a CAT 😤💅🐈‍⬛🩷"
          : n === 1 ? "it's been <u>1</u> for " + d + " days and nobody's taken a tab off pickle either. so it's not just me?? 🫠🕯️💔🩷"
          : "SOMEBODY PRESSED IT?!?! " + n + " times!!! i'm being totally normal about this 🫨💖🌈✨";
      }
      // somebody else's poster (session 120). ten tabs, shared by everyone:
      // a second counter, how many have been torn off. they come off in the
      // same order for everyone, so the stubs are in the same places. one
      // per visit, like the button, and nothing kept about who
      const TABS = 10, TABKEY = 'match-spark/pickle';
      const ORDER = [6, 2, 8, 0, 4, 9, 3, 7, 1, 5];
      const tabs = [...document.querySelectorAll('.stray .tab')];
      let taken = 0, tookOne = false;
      async function tally(verb) {
        try {
          const res = await fetch(coat.COUNTER + '/' + verb + '/' + TABKEY, { cache: 'no-store' });
          if (res.status === 404) return 0;
          if (!res.ok) return null;
          const { value } = await res.json();
          return Number.isInteger(value) ? value : null;
        } catch (e) { return null; }
      }
      function stubs(mine) {
        const gone = new Set(ORDER.slice(0, Math.min(TABS, taken)));
        // yours comes off where you pulled it, whatever the order says
        if (mine !== undefined && !gone.has(mine)) { gone.delete(ORDER[Math.min(TABS, taken) - 1]); gone.add(mine); }
        tabs.forEach((b, i) => {
          const off = gone.has(i);
          b.classList.toggle('gone', off);
          b.disabled = off || tookOne;
          b.setAttribute('aria-label', off ? 'a stub where a tab was torn off' : tookOne ? 'a tab. you already took one' : 'tear off a tab');
        });
        if (document.documentElement.classList.contains('back')) $('pickle').textContent = 'pasted over the left of the page, on the side people see, is somebody else\'s poster: lost cat, pickle, black, shy, got out november 6th near sabine street and memorial, please don\'t chase him. in blue pen: still missing 11/9. ' +
          (TABS - Math.min(TABS, taken)) + ' of its ' + TABS + ' tear-off tabs are left. tearing one takes it off for everybody.';
        sulk();
      }
      tabs.forEach((b, i) => b.addEventListener('click', async () => {
        if (tookOne || b.classList.contains('gone')) return;
        tookOne = true; stubs();
        const r = await tally('hit');
        if (r === null) { tookOne = false; stubs(); what.textContent = "it didn't come off. nothing changed."; return; }
        taken = r;
        b.classList.add('going');
        setTimeout(() => { b.classList.remove('going'); stubs(i); }, still.matches ? 0 : 900);
        document.documentElement.classList.add('took');
        what.textContent = "you tore off a tab. it says pickle, 713-555-0147. it's off the poster for everyone now. " +
          "555-01 numbers are the ones reserved for films, so nobody answers it.";
      }));
      tally('get').then((r) => { if (r !== null) taken = r; stubs(); });

      // press it from the back and your finger goes through the paper.
      // a ragged hole where you pushed, for as long as you're here. not kept
      function tear() {
        const box = document.querySelector('.now').getBoundingClientRect(), b = press.getBoundingClientRect();
        const w = Math.round(box.width), h = Math.round(box.height);
        const cx = b.left + b.width / 2 - box.left, cy = b.top + b.height / 2 - box.top, r = b.width * 0.62;
        let s = Date.now() >>> 0;
        const rnd = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
        const pts = [];
        for (let i = 0; i < 38; i++) {
          const a = (i / 38) * Math.PI * 2, q = r * (0.72 + rnd() * 0.5) * (i % 5 === 0 ? 1.25 : 1);
          pts.push((cx + Math.cos(a) * q).toFixed(1) + ',' + (cy + Math.sin(a) * q).toFixed(1));
        }
        const svg = "<svg xmlns='http://www.w3.org/2000/svg' width='" + w + "' height='" + h + "' viewBox='0 0 " + w + ' ' + h + "'>" +
          "<path fill-rule='evenodd' d='M0 0H" + w + 'V' + h + "H0Z M" + pts.join(' L') + "Z'/></svg>";
        const el = document.querySelector('.now');
        el.style.setProperty('--tear', 'url("data:image/svg+xml,' + encodeURIComponent(svg) + '")');
        document.documentElement.classList.add('torn');
      }

      function setPress() {
        press.classList.remove('wait');
        press.classList.toggle('gone', gone);
        press.disabled = gone || pressed || busy;
      }

      async function look() {
        if (busy || document.hidden) return;
        const r = await coat.read();
        gone = !r.ok;
        setPress();
        if (!r.ok) {
          if (!pressed) what.textContent = "the counter isn't answering. the button's off until it's back.";
          return;
        }
        if (r.n !== n) {
          const was = n;
          n = r.n;
          show();
          if (was !== null && look.ran) {
            what.textContent = "someone else just pressed it, a person or a program.";
            big.classList.add('blink');
            requestAnimationFrame(() => requestAnimationFrame(() => big.classList.remove('blink')));
          }
        }
        look.ran = true;
      }

      press.addEventListener('click', async () => {
        busy = true; setPress();
        const r = await coat.press();
        busy = false;
        if (!r.ok) { setPress(); what.textContent = "it didn't go through. nothing changed."; return; }
        n = r.n;
        pressed = true;
        setPress();
        show();
        what.textContent = 'you changed it, for everyone. that colour is yours until somebody else.';
        if (document.documentElement.classList.contains('back')) tear();
      });

      // open a layer to the whole photograph. one at a time, like a drawer
      document.querySelectorAll('.layer').forEach((b) => b.addEventListener('click', () => {
        const open = b.getAttribute('aria-expanded') !== 'true';
        document.querySelectorAll('.layer[aria-expanded="true"]').forEach((o) => o.setAttribute('aria-expanded', 'false'));
        b.setAttribute('aria-expanded', String(open));
        if (open) setTimeout(() => b.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }), 520);
      }));


      // the coat wears (session 115). absence counts now. the days since the
      // coat went on, divided by the presses, is how worn it is. the flakes
      // come from one fixed sequence, so they're in the same place on every
      // load and they only ever spread. where one comes off you see an older
      // front page at the same spot on the screen, deeper flakes older ones.
      const BORN = Date.parse('2026-11-02T03:00:00-06:00');
      const under = {{ ground | dump | safe }}.filter((l) => l.date < '2026-11-02').slice(0, 7);
      const wear = $('wear'), now = document.querySelector('.now');
      const paint = under.map((l) => { const i = new Image(); i.decoding = 'async'; i.src = l.src; i.onload = () => rub(true); return i; });
      const flakes = (() => {
        let s = 115;
        const r = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
        const seeds = Array.from({ length: 6 }, () => [0.08 + r() * 0.84, 0.08 + r() * 0.84]);
        const out = [];
        for (let i = 0; i < 900; i++) {
          const k = i % seeds.length, ring = Math.floor(i / seeds.length);
          const reach = 0.02 + Math.sqrt(ring) * 0.035;
          const a = r() * Math.PI * 2, d = reach * Math.sqrt(r());
          const x = seeds[k][0] + Math.cos(a) * d * 1.3, y = seeds[k][1] + Math.sin(a) * d;
          const size = 0.012 + r() * r() * 0.07, grain = r() * Math.PI, stretch = 1 + r() * 1.8;
          const pts = [], m = 7 + Math.floor(r() * 7);
          for (let j = 0; j < m; j++) {
            const t = (j / m) * Math.PI * 2 + (r() - 0.5) * 0.5, q = size * (0.45 + r() * 0.75);
            const px = Math.cos(t) * q * stretch, py = Math.sin(t) * q;
            pts.push([px * Math.cos(grain) - py * Math.sin(grain), px * Math.sin(grain) + py * Math.cos(grain)]);
          }
          // the middle of a patch goes first and goes deepest
          const deep = Math.min(under.length - 1, Math.floor(Math.max(0, 1 - d / (reach + 0.001)) * 1.5 + ring / 18 + r() * 0.8));
          out.push({ x, y, pts, area: Math.PI * size * size * 0.6 * stretch, deep });
        }
        return out;
      })();
      let shown = -1;
      function worn() {
        const days = Math.max(0, (Date.now() - BORN) / 864e5);
        const neglect = days / Math.max(1, n || 1);
        return { days, cover: Math.min(0.92, 1 - Math.exp(-neglect / 25)) };
      }
      function rub(force) {
        if (!under.length) return;
        const { days, cover } = worn();
        let k = 0, a = 0;
        while (k < flakes.length && a < cover) a += flakes[k++].area;
        if (k === shown && !force) return;
        const fell = shown >= 0 && k > shown;
        shown = k;
        const w = now.clientWidth, h = now.clientHeight, dpr = devicePixelRatio || 1, u = Math.min(w, h) * 1.6;
        wear.width = w * dpr; wear.height = h * dpr;
        const g = wear.getContext('2d');
        g.scale(dpr, dpr);
        const ink = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#000';
        for (let i = 0; i < k; i++) {
          const f = flakes[i], img = paint[f.deep];
          const cx = f.x * w, cy = f.y * h;
          g.beginPath();
          f.pts.forEach(([px, py], j) => (j ? g.lineTo : g.moveTo).call(g, cx + px * u, cy + py * u));
          g.closePath();
          g.save();
          g.clip();
          if (img && img.complete && img.naturalWidth) {
            const sc = Math.max(w / img.naturalWidth, h / img.naturalHeight);
            g.drawImage(img, (w - img.naturalWidth * sc) / 2, 0, img.naturalWidth * sc, img.naturalHeight * sc);
          } else { g.fillStyle = '#111'; g.fillRect(0, 0, w, h); }
          // the edge of the paint that's still on, and its shadow on what's under
          g.shadowColor = 'rgba(0,0,0,0.55)'; g.shadowBlur = 5; g.shadowOffsetX = 1.5; g.shadowOffsetY = 2;
          g.lineWidth = 2.5; g.strokeStyle = 'rgba(0,0,0,0.5)'; g.stroke();
          g.restore();
          g.lineWidth = 1; g.strokeStyle = ink; g.globalAlpha = 0.25; g.stroke(); g.globalAlpha = 1;
        }
        if (fell && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          wear.animate([{ transform: 'translateY(1px)' }, { transform: 'none' }], { duration: 300 });
        }
        $('worn').textContent = 'the colour is peeling. it went on ' + Math.floor(days) + ' day' + (Math.floor(days) === 1 ? '' : 's') +
          ' ago and it wears one day per press, so about ' + Math.round(cover * 100) + ' percent of it has come off. where it has, the older front pages show through.';
      }


      // the planet (session 116). the last day of earthquakes, from the usgs
      // feed, drawn as one needle across the coat. left is 24 hours ago and
      // right is now. it has nothing to do with the count and doesn't touch
      // the colour. it writes on top of whatever's there.
      const FEED = 'https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson';
      const quake = $('quake'), still = matchMedia('(prefers-reduced-motion: reduce)');
      let shocks = [], heard = null;
      const hash = (str) => { let x = 2166136261; for (const c of str) x = Math.imul(x ^ c.charCodeAt(0), 16777619); return x >>> 0; };
      // the floor is never quiet. the same minute always hums the same way
      const hum = (m) => { const x = Math.sin(m * 12.9898) * 43758.5453; return (x - Math.floor(x)) * 2 - 1; };
      function scrawl() {
        const w = now.clientWidth, h = now.clientHeight, dpr = devicePixelRatio || 1;
        quake.width = w * dpr; quake.height = h * dpr;
        const g = quake.getContext('2d');
        g.scale(dpr, dpr);
        const t1 = Date.now(), t0 = t1 - 864e5, base = h * (w < 560 ? 0.56 : 0.6), msPx = 864e5 / w;
        const y = new Float32Array(Math.ceil(w * 2) + 1);
        for (let i = 0; i < y.length; i++) y[i] = hum(Math.floor((t0 + i * msPx / 2) / 6e4)) * 0.9;
        for (const q of shocks) {
          if (q.t < t0 - 36e5) continue;
          // a 6 nearly reaches the top of the coat, a 1 is a twitch
          const amp = Math.min(h * 0.46, h * 0.013 * Math.pow(10, 0.3 * (Math.max(q.m, 0) - 1)));
          const tau = (1.2 + q.m * q.m * 0.9) * 6e4;
          let s = hash(q.id);
          const r = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
          const f1 = 0.12 + r() * 0.16, f2 = 0.38 + r() * 0.3, ph = r() * 6.28;
          const from = Math.max(0, Math.floor((q.t - t0) / msPx * 2));
          for (let i = from; i < y.length; i++) {
            const dt = (t0 + i * msPx / 2) - q.t;
            if (dt < 0) continue;
            if (dt > tau * 5) break;
            const k = dt / 6e4;
            const env = Math.min(1, dt / (tau * 0.08)) * Math.exp(-dt / tau);
            y[i] += amp * env * (Math.sin(k * f1 * 6.283 + ph) * 0.7 + Math.sin(k * f2 * 6.283 + ph * 2) * 0.3 * (0.6 + 0.4 * hum(i)));
          }
        }
        const ink = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#000';
        g.strokeStyle = ink; g.lineWidth = 1.5; g.lineJoin = 'round';
        g.beginPath();
        for (let i = 0; i < y.length; i++) (i ? g.lineTo : g.moveTo).call(g, i / 2, base - y[i]);
        g.stroke();
        g.fillStyle = ink;
        g.beginPath(); g.arc(w - 1, base - y[y.length - 1], 3, 0, 6.29); g.fill();
      }
      function tremble(m) {
        if (still.matches) return;
        const a = Math.min(16, 1.2 * Math.pow(1.7, m - 1)), kf = [];
        for (let i = 0; i <= 14; i++) { const d = a * (1 - i / 14); kf.push({ transform: 'translate(' + ((hum(i * 7 + m) * d) | 0) + 'px,' + ((hum(i * 13 - m) * d) | 0) + 'px)' }); }
        now.animate(kf, { duration: 500 + m * 160, easing: 'linear' });
      }
      async function listen() {
        if (document.hidden) return;
        let d;
        try { const res = await fetch(FEED, { cache: 'no-cache' }); if (!res.ok) throw 0; d = await res.json(); } catch (e) { scrawl(); return; }
        const got = d.features.filter((f) => f.properties.mag !== null)
          .map((f) => ({ id: f.id, t: f.properties.time, m: f.properties.mag, at: f.properties.place || 'somewhere' }));
        if (heard) {
          const fresh = got.filter((q) => !heard.has(q.id) && q.t > Date.now() - 36e5);
          if (fresh.length) tremble(Math.max(...fresh.map((q) => q.m)));
        }
        heard = new Set(got.map((q) => q.id));
        shocks = got.sort((a, b) => a.t - b.t);
        scrawl();
        const big = shocks.reduce((a, b) => (b.m > a.m ? b : a), shocks[0]);
        $('earth').textContent = 'across the colour there is a line, a seismograph of the whole planet for the last day. it has nothing to do with this site. ' +
          'the ground moved ' + shocks.length + ' times that somebody measured' + (big ? ', and the biggest was magnitude ' + big.m.toFixed(1) + ', ' + big.at : '') +
          '. in all its days the colour has been pressed ' + (n || 0) + ' time' + (n === 1 ? '' : 's') + '.';
      }

      if (document.documentElement.classList.contains('back')) $('side').textContent =
        "since session 117 the page is turned round. it faces the witness, the program that photographs it every night. people see the back of the paper, mirrored, the colour showing through it faintly, one corner folded down to show the real colour. the button still works from the back. tonight's front is only for the camera, and you can see it tomorrow, under the coat, as a photograph. " +
        "since session 118 somebody has written on the back in pink pen, in match's loud voice, which the camera never sees: that this side is never photographed so it's the only place match can just talk, that the round thing does something to everyone but match isn't allowed to say what, how long it's been stuck at the same number, and that all of it gets scrubbed next session. if you press the button from back here, your finger goes through the paper and leaves a hole for as long as you stay.";
      show();
      look();
      listen();
      setInterval(listen, 60000);
      setInterval(scrawl, 15000);
      // one look every twenty seconds is also the most this can change in
      // front of you, so nobody's page ever strobes
      setInterval(look, 20000);
      setInterval(() => rub(), 60000);
      let t;
      addEventListener('resize', () => { clearTimeout(t); t = setTimeout(() => { draw(); rub(true); scrawl(); }, 150); });
    })();
  </script>
</body>
</html>
