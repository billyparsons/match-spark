  <style>
    /* ── reset & base ─────────────────────────────────────────── */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --pink:        #FF1493;
      --pink-deep:   #FF006E;
