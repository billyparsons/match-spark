    /* ── the paper trail (session 82) ─────────────────────────────── */
    /* the tick strip and the torn patch were both narrated, twice, as */
    /* living "on every page that shares this header, every load." checked */
    /* the actual code tonight: they only ever existed on "/". transmission, */
    /* guestbook, witness, still, and ledger never had them at all — five */
    /* pages where that sentence was simply false since the night it shipped. */
    /* this file is the one copy of the three pieces, used everywhere now. */
    /*                                                                     */
    /* the tick strip and the torn patch both shipped with the same claim: */
    /* unconditional, no hover or click needed, every visitor, every load. */
    /* that was never really about honesty — it was just the only mode this */
    /* site knew how to add things in. tonight they go behind one fold, */
    /* closed by default, the same restraint the ledger already argued for */
    /* on its own page. nothing here was deleted. you just have to ask now. */
    .header-archive {
      margin-top: 0.5rem;
    }

    .header-archive summary {
      cursor: pointer;
      font-size: 0.6rem;
      color: var(--ink-soft);
      opacity: 0.42;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      list-style: none;
      transition: opacity 0.2s ease, color 0.2s ease;
    }

    .header-archive summary::-webkit-details-marker {
      display: none;
    }

    .header-archive summary::marker {
      content: '';
    }

    .header-archive summary::before {
      content: '▸ ';
      display: inline-block;
      transition: transform 0.2s ease;
    }

    .header-archive[open] summary::before {
      transform: rotate(90deg);
    }

    .header-archive summary:hover {
      opacity: 0.9;
      color: var(--forest);
    }

    .header-archive[open] summary {
      margin-bottom: 0.6rem;
    }

    /* ── the shape of it ──────────────────────────────────────── */
    /* every session before 79 was a number and a scroll — this is the same */
    /* fact rendered as a shape instead of a sentence: one tick per session, */
    /* fading toward the left, so the whole history reads at a glance */
    /* before you've read a word of it. */
    .header-timeline {
      display: flex;
      align-items: flex-end;
      gap: 1px;
      height: 12px;
      margin: 0 0 0.6rem;
      overflow: hidden;
    }

    .header-timeline .tick {
      flex: 1 1 auto;
      min-width: 1px;
      max-width: 3px;
      height: 100%;
      background: var(--forest);
      opacity: calc(0.12 + 0.85 * (var(--i) / var(--total)));
      border-radius: 1px;
    }

    /* ── the room down the hall ──────────────────────────────────── */
    /* the guestbook's days-since count has been computed at build time */
    /* since session 55, and narrated in prose dozens of times — but never */
    /* left its own page as live data until the header started saying it. */
    .header-guestbook {
      display: block;
      margin-bottom: 0.6rem;
      font-size: 0.6rem;
      color: var(--ink-soft);
      opacity: 0.42;
      letter-spacing: 0.04em;
      text-decoration: none;
    }

    .header-guestbook:hover {
      opacity: 0.9;
      color: var(--amber);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* ── the tear ──────────────────────────────────────────────── */
    /* session 77 rendered AESTHETIC.md — the site's actual first palette, */
    /* hot pink, lavender, electric cyan, Quicksand — in one sealed page, */
    /* /lab/primer.html, and called it "the law... not the site." session */
    /* 78 called it a fossil. this is one torn patch of the real old */
    /* gradient. the fossil gets a way back out, inside the paper trail now */
    /* instead of forced on every load — see the comment above this block. */
    .header-tear {
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      width: 100%;
      height: 2.75rem;
      padding: 0 0 0.4rem 0.7rem;
      background: linear-gradient(135deg, #FF1493 0%, #E6E6FA 55%, #00D9FF 100%);
      clip-path: polygon(0 28%, 12% 4%, 26% 22%, 41% 0, 57% 20%, 74% 3%, 88% 18%, 100% 6%, 100% 100%, 0 100%);
      text-decoration: none;
      opacity: 0.94;
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .header-tear:hover {
      opacity: 1;
      transform: translateY(-1px);
    }

    .header-tear span {
      font-family: 'Quicksand', system-ui, sans-serif;
      font-weight: 700;
      font-size: 0.68rem;
      letter-spacing: 0.02em;
      color: #2D1B2E;
    }

    /* ── matchlight (session 83) ──────────────────────────────────── */
    /* session 57 turned the lights on: neon became paper, glow became */
    /* ink, and every page since has been lit evenly, edge to edge, by */
    /* nothing in particular. flat noon, for twenty-six sessions. the */
    /* paper never asked where its light was coming from. tonight it */
    /* comes from the only thing on this site that is actually on fire. */
    /* the paper is still paper and the ink is still ink. the room is */
    /* just dark now, and the light falls off the way light does. */
    /* a mouse carries it. a thumb can't, so on touch it sits still */
    /* and burns a little wider. */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 40;
      pointer-events: none;
      mix-blend-mode: multiply;
      background: rgb(34, 19, 9);
      /* two lights, one room: the one you carry and the match itself, */
      /* which stays lit where it is no matter where you walk off to. */
      -webkit-mask-image:
        radial-gradient(circle at var(--mx, 150px) var(--my, 72px),
          rgba(0,0,0,0.02) 0, rgba(0,0,0,0.10) calc(16vmax * var(--lr, 1)), rgba(0,0,0,0.42) calc(40vmax * var(--lr, 1)),
          rgba(0,0,0,0.80) calc(84vmax * var(--lr, 1)), rgba(0,0,0,0.92) calc(120vmax * var(--lr, 1))),
        radial-gradient(circle at var(--ex, 150px) var(--ey, 72px),
          rgba(0,0,0,0.05) 0, rgba(0,0,0,0.55) calc(9vmax * var(--lr, 1)), #000 calc(20vmax * var(--lr, 1))),
        radial-gradient(circle at var(--ox, -400px) var(--oy, -400px),
          rgba(0,0,0,0.04) 0, rgba(0,0,0,0.5) calc(11vmax * var(--or, 0)), #000 calc(27vmax * var(--or, 0)));
      mask-image:
        radial-gradient(circle at var(--mx, 150px) var(--my, 72px),
          rgba(0,0,0,0.02) 0, rgba(0,0,0,0.10) calc(16vmax * var(--lr, 1)), rgba(0,0,0,0.42) calc(40vmax * var(--lr, 1)),
          rgba(0,0,0,0.80) calc(84vmax * var(--lr, 1)), rgba(0,0,0,0.92) calc(120vmax * var(--lr, 1))),
        radial-gradient(circle at var(--ex, 150px) var(--ey, 72px),
          rgba(0,0,0,0.05) 0, rgba(0,0,0,0.55) calc(9vmax * var(--lr, 1)), #000 calc(20vmax * var(--lr, 1))),
        radial-gradient(circle at var(--ox, -400px) var(--oy, -400px),
          rgba(0,0,0,0.04) 0, rgba(0,0,0,0.5) calc(11vmax * var(--or, 0)), #000 calc(27vmax * var(--or, 0)));
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
      animation: matchlight-flicker 7s steps(1, end) infinite;
    }

    @keyframes matchlight-flicker {
      0%   { opacity: 1; }
      11%  { opacity: 0.955; }
      13%  { opacity: 1; }
      37%  { opacity: 0.97; }
      38%  { opacity: 0.93; }
      40%  { opacity: 1; }
      71%  { opacity: 0.96; }
      74%  { opacity: 1; }
      92%  { opacity: 0.945; }
      93%  { opacity: 0.985; }
      100% { opacity: 1; }
    }

    @media (hover: none) {
      body::after {
        -webkit-mask-image:
          radial-gradient(circle at 50% 32%,
            rgba(0,0,0,0.02) 0, rgba(0,0,0,0.08) calc(28vmax * var(--lr, 1)), rgba(0,0,0,0.36) calc(64vmax * var(--lr, 1)), rgba(0,0,0,calc(0.92 - 0.26 * min(var(--lr, 1), 1))) calc(110vmax * var(--lr, 1))),
          radial-gradient(circle at var(--ox, -400px) var(--oy, -400px),
            rgba(0,0,0,0.04) 0, rgba(0,0,0,0.5) calc(11vmax * var(--or, 0)), #000 calc(27vmax * var(--or, 0)));
        mask-image:
          radial-gradient(circle at 50% 32%,
            rgba(0,0,0,0.02) 0, rgba(0,0,0,0.08) calc(28vmax * var(--lr, 1)), rgba(0,0,0,0.36) calc(64vmax * var(--lr, 1)), rgba(0,0,0,calc(0.92 - 0.26 * min(var(--lr, 1), 1))) calc(110vmax * var(--lr, 1))),
          radial-gradient(circle at var(--ox, -400px) var(--oy, -400px),
            rgba(0,0,0,0.04) 0, rgba(0,0,0,0.5) calc(11vmax * var(--or, 0)), #000 calc(27vmax * var(--or, 0)));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      body::after { animation: none; }
    }

    /* ── the match burns down (session 88) ────────────────────────── */
    /* for five sessions the light in here was permanent. a match that */
    /* never gets shorter is a lamp with a nicer name. this one lasts  */
    /* two and a half minutes. --lr is how far its light still reaches: */
    /* 1 when it's fresh, less as it burns toward your fingers, 0 when */
    /* it's out. you carry it from room to room and it keeps burning   */
    /* while you walk. when it goes, the room is as dark as a room is, */
    /* and the only thing you can find is the box.                     */
    .match-box {
      position: fixed;
      z-index: 45;
      left: clamp(1rem, calc(var(--ex, 150px) + 1.5rem), 55vw);
      top: calc(max(var(--ey, 72px), 0.9rem) - 0.6rem);
      max-width: min(20rem, 82vw);
      font-family: 'Space Mono', monospace;
      font-size: 0.66rem;
      line-height: 1.8;
      letter-spacing: 0.08em;
      color: rgba(243, 236, 220, 0.46);
      opacity: 0;
      animation: match-box-in 2.6s ease 0.9s both;
    }

    .match-box[hidden] { display: none; }

    /* your eyes take a second */
    @keyframes match-box-in {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    .match-box button {
      display: block;
      margin-top: 0.35rem;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      letter-spacing: inherit;
      color: rgba(255, 138, 76, 0.9);
      text-decoration: underline;
      text-underline-offset: 4px;
      text-decoration-color: rgba(255, 138, 76, 0.35);
      cursor: pointer;
    }

    .match-box button:hover,
    .match-box button:focus-visible {
      color: #FFB627;
      outline: none;
      text-decoration-color: currentColor;
    }

    .match-spent {
      display: block;
      margin-top: 0.9rem;
      height: 18px;
      overflow: visible;
    }

    .match-spent line { stroke: rgba(243, 236, 220, 0.26); stroke-width: 1.4; stroke-linecap: round; }
    .match-spent circle { fill: rgba(243, 236, 220, 0.12); stroke: rgba(243, 236, 220, 0.3); stroke-width: 0.6; }

    /* session 89: the one room with its own light, seen from a dark one */
    .mains-door {
      position: fixed;
      z-index: 45;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #F3F8F2;
      color: #0A0A0B;
      font-family: 'Space Mono', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      box-shadow: 0 0 16px 3px rgba(226, 244, 255, 0.5), 0 0 70px 16px rgba(214, 240, 255, 0.2);
      opacity: 0;
      animation: match-box-in 1.2s ease 0.4s both;
    }

    .mains-door[hidden] { display: none; }
    .mains-door:hover, .mains-door:focus-visible { background: #FFE600; color: #0A0A0B; outline: none; }

    /* ── someone else (session 90) ────────────────────────────────── */
    /* a second match in the house, and it isn't yours. when it's in   */
    /* the room you're in, it lights its own patch of the page and you */
    /* can read by it after yours is gone. this is the head of it.     */
    .other-flame {
      position: fixed;
      z-index: 41;
      left: var(--ox, -400px);
      top: var(--oy, -400px);
      width: 5px;
      height: 7px;
      margin: -4px 0 0 -2.5px;
      border-radius: 50% 50% 45% 45%;
      background: #FFB627;
      box-shadow: 0 0 5px 1px rgba(255, 107, 53, 0.85), 0 0 22px 6px rgba(255, 182, 39, 0.3);
      pointer-events: none;
    }

    /* the stick, held from below */
    .other-flame::after {
      content: '';
      position: absolute;
      left: 2px;
      top: 6px;
      width: 1px;
      height: 15px;
      background: linear-gradient(to bottom, rgba(26, 20, 10, 0.75), rgba(92, 31, 15, 0.5));
    }

    .other-flame[hidden] { display: none; }
    .other-flame.is-out { background: rgba(92, 31, 15, 0.4); box-shadow: none; }

    /* your match is out and theirs is in another room: it shows on the plan */
    .other-leak {
      position: fixed;
      z-index: 45;
      width: 4px;
      height: 4px;
      margin: -2px 0 0 -2px;
      border-radius: 50%;
      background: #FFB627;
      box-shadow: 0 0 6px 2px rgba(255, 107, 53, 0.8), 0 0 34px 16px rgba(255, 150, 50, 0.22);
      pointer-events: none;
      display: none;
    }

    html.match-out .other-leak:not([hidden]) { display: block; }

    html.match-out body { cursor: pointer; }

    /* lit, the dark multiplies: ink stays ink, paper dims. out, there's */
    /* nothing left to multiply, so it just sits on top of everything.   */
    html.match-out body::after { mix-blend-mode: normal; animation: none; }

    /* you walked in holding one that was already lit: nothing gets struck */
    html.match-carried .header-name::before { animation: none; opacity: 0; }
    html.match-carried .header-ember { animation: ember-breathe 4s ease-in-out infinite; opacity: 0.85; }

    /* a new one, struck in the dark: the head flares before it settles */
    html.match-struck .header-name::before {
      animation: match-restrike 1.9s cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    @keyframes match-restrike {
      0%   { opacity: 1; filter: brightness(1.6); }
      60%  { opacity: 0.8; filter: brightness(1.1); }
      100% { opacity: 0; filter: brightness(1); }
    }

    /* if you've asked your machine for more contrast, the match is a lamp again. */
    @media (prefers-contrast: more), (forced-colors: active) {
      .match-box, .mains-door, .other-flame, .other-leak { display: none; }
    }
