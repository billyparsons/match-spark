    <script>
      /* matchlight (session 83): the light starts at the ember and goes */
      /* wherever a mouse takes it.                                      */
      (function () {
        var root = document.documentElement;
        var ember = document.querySelector('.header-ember') || document.querySelector('.header-name');
        var x = 150, y = 72, tx = x, ty = y, raf = null;
        function home() {
          if (!ember) return;
          var r = ember.getBoundingClientRect();
          tx = r.left + r.width / 2;
          ty = Math.max(r.top + r.height / 2, 0);
          root.style.setProperty('--ex', tx.toFixed(1) + 'px');
          root.style.setProperty('--ey', ty.toFixed(1) + 'px');
        }
        function paint() {
          root.style.setProperty('--mx', x.toFixed(1) + 'px');
          root.style.setProperty('--my', y.toFixed(1) + 'px');
        }
        function step() {
          x += (tx - x) * 0.09;
          y += (ty - y) * 0.09;
          paint();
          raf = (Math.abs(tx - x) + Math.abs(ty - y) > 0.5) ? requestAnimationFrame(step) : null;
        }
        function go() { if (!raf) raf = requestAnimationFrame(step); }
        home(); x = tx; y = ty; paint();
        window.addEventListener('pointermove', function (e) {
          if (e.pointerType !== 'mouse') return;
          tx = e.clientX; ty = e.clientY; go();
        }, { passive: true });
        /* the mouse leaves the window: the light walks back to the match */
        document.addEventListener('mouseleave', function () { home(); go(); });
        /* the header scrolls away on narrow screens; keep the match's own light on the match */
        window.addEventListener('scroll', function () { var a = tx, b = ty; home(); tx = a; ty = b; }, { passive: true });
        window.addEventListener('resize', function () { home(); go(); });
      })();
    </script>
    <script>
      /* the match burns down (session 88). a match lasts BURN and then  */
      /* it is out. the time it was struck goes in sessionStorage, so the */
      /* one you're holding comes with you between rooms and is gone when */
      /* the tab is. the count of dead ones goes there too. /outside      */
      /* reads the same two keys to know whether the window is lit.       */
      (function () {
        var BURN = 150000;
        var root = document.documentElement;
        var mq = window.matchMedia ? window.matchMedia.bind(window) : function () { return { matches: false }; };
        if (mq('(prefers-contrast: more)').matches || mq('(forced-colors: active)').matches) return;
        var calm = mq('(prefers-reduced-motion: reduce)').matches;
        var mem = {};
        function get(k) { try { var v = sessionStorage.getItem(k); return v === null ? mem[k] : v; } catch (e) { return mem[k]; } }
        function set(k, v) { mem[k] = String(v); try { sessionStorage.setItem(k, v); } catch (e) {} }

        var struck = parseInt(get('match-struck'), 10);
        var spent = parseInt(get('match-spent'), 10) || 0;
        var flare = 0, out = false, box = null, timer = null;

        if (!struck || struck > Date.now()) { struck = Date.now(); set('match-struck', struck); }
        else root.classList.add('match-carried');

        /* how far the light reaches, 0..1, for how much of the match is gone */
        function reach(p, t) {
          if (p >= 1) return 0;
          if (p < 0.45) return 1;
          var r;
          if (p < 0.88) { var k = (p - 0.45) / 0.43; r = 1 - 0.46 * k * k; }
          else { var g = (p - 0.88) / 0.12; r = 0.54 - 0.4 * g; }
          /* the last of it gutters */
          if (p > 0.8 && !calm) {
            var a = (p - 0.8) / 0.2;
            r *= 1 - a * (0.1 + 0.1 * Math.sin(t * 0.021) + 0.08 * Math.sin(t * 0.047 + 1.3) + (Math.sin(t * 0.0031) > 0.93 ? 0.3 : 0));
          }
          return Math.max(r, 0.04);
        }

        function sticks(n) {
          var show = Math.min(n, 40), w = show * 7 + 6, s = '';
          for (var i = 0; i < show; i++) {
            /* each one lies where it fell: same lean every time for the same match */
            var lean = ((i * 37) % 11) - 5, cx = 5 + i * 7;
            s += '<line x1="' + (cx + lean * 0.5) + '" y1="16" x2="' + (cx - lean * 0.5) + '" y2="4"/>' +
                 '<circle cx="' + (cx - lean * 0.5) + '" cy="3" r="1.5"/>';
          }
          return '<svg class="match-spent" width="' + w + '" height="18" viewBox="0 0 ' + w + ' 18" role="img" aria-label="' + n + ' spent">' + s + '</svg>';
        }

        /* each match is counted once, in whichever room it died in or was found dead in */
        function dark() {
          if (out) return;
          if (parseInt(get('match-counted'), 10) !== struck) {
            spent += 1; set('match-spent', spent); set('match-counted', struck);
          }
          finish();
        }

        function finish() {
          out = true;
          root.style.setProperty('--lr', '0');
          root.classList.add('match-out');
          root.classList.remove('match-struck');
          if (timer) { clearInterval(timer); timer = null; }
          if (!box) {
            box = document.createElement('div');
            box.className = 'match-box';
            document.body.insertBefore(box, document.body.firstChild);
          }
          box.innerHTML = 'the match is out.<button type="button">strike another</button>' + sticks(spent);
          box.hidden = false;
        }

        function strike() {
          out = false;
          struck = Date.now(); set('match-struck', struck);
          flare = calm ? 0 : 0.55;
          if (box) box.hidden = true;
          root.classList.remove('match-out', 'match-carried');
          root.classList.remove('match-struck');
          void root.offsetWidth;
          root.classList.add('match-struck');
          burn();
        }

        function tick() {
          var now = Date.now(), p = (now - struck) / BURN;
          if (p >= 1) { dark(); return; }
          flare *= 0.9;
          root.style.setProperty('--lr', (reach(p, now) + flare).toFixed(3));
        }

        function burn() { tick(); if (!timer && !out) timer = setInterval(tick, 70); }

        /* in the dark there is one thing to do, and anything you press does it */
        document.addEventListener('click', function (e) {
          if (!out) return;
          e.preventDefault(); e.stopPropagation();
          strike();
        }, true);

        /* a tab left open keeps burning. coming back to it, it may be over. */
        document.addEventListener('visibilitychange', function () { if (!document.hidden && !out) tick(); });

        /* it may have gone out on the way here, or outside, or in a tab nobody was looking at */
        if (Date.now() - struck >= BURN) dark(); else burn();
      })();
    </script>
