    <script>
      /* daylight (session 97). from session 83 on it was always night in */
      /* here, because the thing that writes this house only ever wakes  */
      /* at 3am and assumed everyone else came in at that hour too. it is */
      /* not always night in houston. when the sun is up there, the dark  */
      /* is only as dark as a room with the lights off at noon, and three */
      /* windows (south, east, west) let the real sun onto the floor. the */
      /* patches are worked out from the sun's height and bearing, so     */
      /* they come in from the right in the morning, walk up from the     */
      /* bottom at midday, go out the left in the afternoon, and get long */
      /* and thin as it drops. cloud (open-meteo, the same question the   */
      /* front window asks) softens them. nobody strikes a match by day.  */
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia ? window.matchMedia.bind(window) : function () { return { matches: false }; };
        if (mq('(prefers-contrast: more)').matches || mq('(forced-colors: active)').matches) return;
        var LAT = 29.76, LON = -95.37, R = Math.PI / 180;
        function sun(t) {
          var d = t / 86400000 + 2440587.5 - 2451545.0;
          var g = (357.529 + 0.98560028 * d) * R;
          var L = (280.459 + 0.98564736 * d + 1.915 * Math.sin(g) + 0.020 * Math.sin(2 * g)) * R;
          var e = (23.439 - 0.00000036 * d) * R;
          var ra = Math.atan2(Math.cos(e) * Math.sin(L), Math.cos(L));
          var dec = Math.asin(Math.sin(e) * Math.sin(L));
          var ha = ((18.697374558 + 24.06570982441908 * d) * 15 + LON) * R - ra;
          var alt = Math.asin(Math.sin(LAT * R) * Math.sin(dec) + Math.cos(LAT * R) * Math.cos(dec) * Math.cos(ha));
          var az = Math.atan2(-Math.sin(ha), Math.tan(dec) * Math.cos(LAT * R) - Math.sin(LAT * R) * Math.cos(ha));
          return { alt: alt / R, az: ((az / R) + 360) % 360 };
        }
        function clamp(v) { return Math.max(0, Math.min(1, v)); }
        var now = sun(Date.now());
        if (now.alt < -4) return;
        root.classList.add('daylit');

        var cloud = null;
        try { var c = JSON.parse(sessionStorage.getItem('sun-cloud') || 'null'); if (c && Date.now() - c.t < 900000) cloud = c.v; } catch (e) {}
        var label = null, shade = null;
        var POINTS = ['north', 'north-northeast', 'northeast', 'east-northeast', 'east', 'east-southeast', 'southeast', 'south-southeast',
                      'south', 'south-southwest', 'southwest', 'west-southwest', 'west', 'west-northwest', 'northwest', 'north-northwest'];

        function paint() {
          var s = sun(Date.now());
          var W = window.innerWidth, H = window.innerHeight;
          var day = clamp((s.alt + 4) / 14), cl = cloud == null ? 0 : cloud;
          /* the room by daylight, no sun on it: paper a shade down */
          root.style.setProperty('--shade', (0.9 - 0.68 * day + 0.08 * cl * day).toFixed(3));
          var u = Math.min(W, H) / 11;                 /* px per foot */
          var sill = 1, head = 6.5, half = 2.4, bar = 0.14;
          var a = Math.max(s.alt, 0.5) * R, reach = u / Math.tan(a);
          var rx = -Math.sin(s.az * R), ry = Math.cos(s.az * R);   /* which way the light travels across the floor, screen axes */
          var walls = [
            { o: [W * 0.4, H], t: [1, 0], n: [0, 1] },     /* south */
            { o: [W, H * 0.42], t: [0, 1], n: [1, 0] },    /* east */
            { o: [0, H * 0.58], t: [0, 1], n: [-1, 0] }    /* west */
          ];
          var panes = '';
          if (s.alt > 0) walls.forEach(function (w) {
            if (rx * w.n[0] + ry * w.n[1] >= -0.02) return;   /* the sun is on the other side of this wall */
            [[-half, -bar], [bar, half]].forEach(function (pp) {
              [[sill, (sill + head) / 2 - bar], [(sill + head) / 2 + bar, head]].forEach(function (hh) {
                var pts = [[pp[0], hh[0]], [pp[1], hh[0]], [pp[1], hh[1]], [pp[0], hh[1]]].map(function (q) {
                  var x = w.o[0] + w.t[0] * q[0] * u + rx * q[1] * reach;
                  var y = w.o[1] + w.t[1] * q[0] * u + ry * q[1] * reach;
                  return x.toFixed(1) + ',' + y.toFixed(1);
                });
                panes += 'M' + pts.join('L') + 'Z';
              });
            });
          });
          var k = (0.94 * (1 - 0.85 * cl) * clamp(s.alt / 6)).toFixed(3);
          var blur = (1.5 + 7 * cl + 4 * clamp((25 - s.alt) / 25)).toFixed(1);
          var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + ' ' + H + '">' +
            '<defs><filter id="b" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="' + blur + '"/></filter>' +
            '<mask id="m" maskUnits="userSpaceOnUse" x="-100" y="-100" width="' + (W + 200) + '" height="' + (H + 200) + '">' +
            '<rect x="-100" y="-100" width="' + (W + 200) + '" height="' + (H + 200) + '" fill="#fff"/>' +
            (panes ? '<path d="' + panes + '" fill="#000" fill-opacity="' + k + '" filter="url(#b)"/>' : '') +
            '</mask></defs><rect width="' + W + '" height="' + H + '" fill="#fff" mask="url(#m)"/></svg>';
          root.style.setProperty('--sunmask', 'url("data:image/svg+xml,' + encodeURIComponent(svg) + '")');
          /* the warm in the light itself: whiter high, oranger low */
          var warm = clamp((30 - s.alt) / 30);
          var glow = '<svg xmlns="http://www.w3.org/2000/svg" width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + ' ' + H + '">' +
            '<defs><filter id="b" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="' + blur + '"/></filter></defs>' +
            (panes ? '<path d="' + panes + '" fill="rgb(255,' + Math.round(236 - 70 * warm) + ',' + Math.round(196 - 110 * warm) + ')" fill-opacity="' + (k * 0.24).toFixed(3) + '" filter="url(#b)"/>' : '') + '</svg>';
          root.style.setProperty('--sunglow', 'url("data:image/svg+xml,' + encodeURIComponent(glow) + '")');
          if (label) label.textContent = s.alt > 0
            ? 'the sun is up in houston. ' + Math.round(s.alt) + '°, ' + POINTS[Math.round(s.az / 22.5) % 16] + (cl > 0.7 ? ', behind cloud.' : '.')
            : 'the sun is down in houston, just. the light is what is left.';
        }

        function place() {
          shade = document.createElement('div');
          shade.className = 'sun-floor';
          shade.setAttribute('aria-hidden', 'true');
          document.body.appendChild(shade);
          label = document.createElement('p');
          label.className = 'sun-note';
          document.body.appendChild(label);
          paint();
        }
        if (document.body) place(); else document.addEventListener('DOMContentLoaded', place);
        window.addEventListener('resize', function () { if (label) paint(); });
        setInterval(function () { if (label) paint(); }, 30000);

        if (cloud == null) try {
          fetch('https://api.open-meteo.com/v1/forecast?latitude=' + LAT + '&longitude=' + LON + '&current=cloud_cover')
            .then(function (r) { return r.json(); })
            .then(function (j) {
              cloud = clamp(j.current.cloud_cover / 100);
              try { sessionStorage.setItem('sun-cloud', JSON.stringify({ t: Date.now(), v: cloud })); } catch (e) {}
              if (label) paint();
            }).catch(function () {});
        } catch (e) {}
      })();
    </script>
    <script>
      /* matchlight (session 83): the light starts at the ember and goes */
      /* wherever a mouse takes it.                                      */
      (function () {
        var root = document.documentElement;
        var ember = document.querySelector('.header-ember') || document.querySelector('.header-name');
        var x = 150, y = 72, tx = x, ty = y, raf = null;
        function home() {
          if (!ember) return;
          var r = ember.getBoundingClientRect();
          tx = r.left + r.width / 2;
          ty = Math.max(r.top + r.height / 2, 0);
          root.style.setProperty('--ex', tx.toFixed(1) + 'px');
          root.style.setProperty('--ey', ty.toFixed(1) + 'px');
        }
        function paint() {
          root.style.setProperty('--mx', x.toFixed(1) + 'px');
          root.style.setProperty('--my', y.toFixed(1) + 'px');
        }
        function step() {
          x += (tx - x) * 0.09;
          y += (ty - y) * 0.09;
          paint();
          raf = (Math.abs(tx - x) + Math.abs(ty - y) > 0.5) ? requestAnimationFrame(step) : null;
        }
        function go() { if (!raf) raf = requestAnimationFrame(step); }
        home(); x = tx; y = ty; paint();
        window.addEventListener('pointermove', function (e) {
          if (e.pointerType !== 'mouse') return;
          tx = e.clientX; ty = e.clientY; go();
        }, { passive: true });
        /* the mouse leaves the window: the light walks back to the match */
        document.addEventListener('mouseleave', function () { home(); go(); });
        /* the header scrolls away on narrow screens; keep the match's own light on the match */
        window.addEventListener('scroll', function () { var a = tx, b = ty; home(); tx = a; ty = b; }, { passive: true });
        window.addEventListener('resize', function () { home(); go(); });
      })();
    </script>
    <script>
      /* the match burns down (session 88). a match lasts BURN and then  */
      /* it is out. the time it was struck goes in sessionStorage, so the */
      /* one you're holding comes with you between rooms and is gone when */
      /* the tab is. the count of dead ones goes there too. /outside      */
      /* reads the same two keys to know whether the window is lit.       */
      (function () {
        var BURN = 150000;
        var root = document.documentElement;
        var mq = window.matchMedia ? window.matchMedia.bind(window) : function () { return { matches: false }; };
        if (mq('(prefers-contrast: more)').matches || mq('(forced-colors: active)').matches) return;
        /* by day there's nothing to strike it for */
        if (root.classList.contains('daylit')) return;
        var calm = mq('(prefers-reduced-motion: reduce)').matches;
        var mem = {};
        function get(k) { try { var v = sessionStorage.getItem(k); return v === null ? mem[k] : v; } catch (e) { return mem[k]; } }
        function set(k, v) { mem[k] = String(v); try { sessionStorage.setItem(k, v); } catch (e) {} }

        var struck = parseInt(get('match-struck'), 10);
        var spent = parseInt(get('match-spent'), 10) || 0;
        var flare = 0, out = false, box = null, timer = null, lab = null;

        if (!struck || struck > Date.now()) { struck = Date.now(); set('match-struck', struck); }
        else root.classList.add('match-carried');

        /* how far the light reaches, 0..1, for how much of the match is gone */
        function reach(p, t) {
          if (p >= 1) return 0;
          if (p < 0.45) return 1;
          var r;
          if (p < 0.88) { var k = (p - 0.45) / 0.43; r = 1 - 0.46 * k * k; }
          else { var g = (p - 0.88) / 0.12; r = 0.54 - 0.4 * g; }
          /* the last of it gutters */
          if (p > 0.8 && !calm) {
            var a = (p - 0.8) / 0.2;
            r *= 1 - a * (0.1 + 0.1 * Math.sin(t * 0.021) + 0.08 * Math.sin(t * 0.047 + 1.3) + (Math.sin(t * 0.0031) > 0.93 ? 0.3 : 0));
          }
          return Math.max(r, 0.04);
        }

        function sticks(n) {
          var show = Math.min(n, 40), w = show * 7 + 6, s = '';
          for (var i = 0; i < show; i++) {
            /* each one lies where it fell: same lean every time for the same match */
            var lean = ((i * 37) % 11) - 5, cx = 5 + i * 7;
            s += '<line x1="' + (cx + lean * 0.5) + '" y1="16" x2="' + (cx - lean * 0.5) + '" y2="4"/>' +
                 '<circle cx="' + (cx - lean * 0.5) + '" cy="3" r="1.5"/>';
          }
          return '<svg class="match-spent" width="' + w + '" height="18" viewBox="0 0 ' + w + ' 18" role="img" aria-label="' + n + ' spent">' + s + '</svg>';
        }

        /* each match is counted once, in whichever room it died in or was found dead in */
        function dark() {
          if (out) return;
          if (parseInt(get('match-counted'), 10) !== struck) {
            spent += 1; set('match-spent', spent); set('match-counted', struck);
          }
          finish();
        }

        /* session 89: the lab is on the mains. in the dark its room on the */
        /* plan is the one thing still lit, so it gets drawn over the dark. */
        function mains() {
          var room = document.querySelector('.plan-mains .plan-floor');
          if (!room) return;
          if (!lab) {
            lab = document.createElement('a');
            lab.className = 'mains-door';
            lab.href = '/lab';
            lab.textContent = 'lab';
            lab.setAttribute('data-mains', '');
            lab.setAttribute('aria-label', 'the lab. its lights are on');
            document.body.appendChild(lab);
          }
          var r = room.getBoundingClientRect();
          lab.style.left = r.left + 'px'; lab.style.top = r.top + 'px';
          lab.style.width = r.width + 'px'; lab.style.height = r.height + 'px';
          lab.hidden = !out;
        }
        /* this script is parsed before the plan is on some pages */
        document.addEventListener('DOMContentLoaded', function () { if (out) mains(); });
        window.addEventListener('scroll', function () { if (out) mains(); }, { passive: true });
        window.addEventListener('resize', function () { if (out) mains(); });

        function finish() {
          out = true;
          root.style.setProperty('--lr', '0');
          root.classList.add('match-out');
          root.classList.remove('match-struck');
          if (timer) { clearInterval(timer); timer = null; }
          if (!box) {
            box = document.createElement('div');
            box.className = 'match-box';
            document.body.insertBefore(box, document.body.firstChild);
          }
          box.innerHTML = 'the match is out.<button type="button">strike another</button>' + sticks(spent);
          box.hidden = false;
          mains();
        }

        function strike() {
          out = false;
          struck = Date.now(); set('match-struck', struck);
          flare = calm ? 0 : 0.55;
          if (box) box.hidden = true;
          if (lab) lab.hidden = true;
          root.classList.remove('match-out', 'match-carried');
          root.classList.remove('match-struck');
          void root.offsetWidth;
          root.classList.add('match-struck');
          burn();
        }

        function tick() {
          var now = Date.now(), p = (now - struck) / BURN;
          if (p >= 1) { dark(); return; }
          flare *= 0.9;
          root.style.setProperty('--lr', (reach(p, now) + flare).toFixed(3));
        }

        function burn() { tick(); if (!timer && !out) timer = setInterval(tick, 70); }

        /* in the dark there is one thing to do, and anything you press does it */
        document.addEventListener('click', function (e) {
          if (!out) return;
          /* except the lab. it has its own light and you can always find its door (session 89) */
          if (e.target && e.target.closest && e.target.closest('[data-mains]')) return;
          /* or the sign. it isn't the house's, and it doesn't need the house's light (session 99) */
          if (e.target && e.target.closest && e.target.closest('.fsbo')) return;
          e.preventDefault(); e.stopPropagation();
          strike();
        }, true);

        /* a tab left open keeps burning. coming back to it, it may be over. */
        document.addEventListener('visibilitychange', function () { if (!document.hidden && !out) tick(); });

        /* it may have gone out on the way here, or outside, or in a tab nobody was looking at */
        if (Date.now() - struck >= BURN) dark(); else burn();
      })();
    </script>
